#!/usr/bin/env bash
# oclimits: write OpenCode's Go plan usage to ~/.cache/opencode-status/limits.json,
# for herdr's tab bar on another machine (hlimits fetches it over the tailnet,
# so no SSH and no key is needed there).
#
# The numbers come from the local OpenCode server's experimental endpoint
# experimental.usage.limits, which needs the Go workspace's Console account
# sign-in as the active credential. The agents need the pay-as-you-go key
# active instead (another workspace), and OpenCode keeps one active login per
# integration, so oclimits runs its own OpenCode instance: own data dirs under
# ~/.local/share/oclimits holding only the account login, own service port
# (49375). Set up once (secrets never printed):
#   B=~/.local/share/oclimits; oc() { XDG_CONFIG_HOME=$B/config XDG_DATA_HOME=$B/data \
#     XDG_STATE_HOME=$B/state XDG_CACHE_HOME=$B/cache opencode "$@"; }
#   oc service set port 49375
#   opencode auth export | jq '[.[] | select(.label == "Personal") | .active = true]' > $B/p.json
#   oc auth import $B/p.json; shred -u $B/p.json
# Run every few minutes
# by oclimits.timer (tools/opencode). Writes only the go windows and the
# time of the query, plus the pay-as-you-go budget (spent, limit, reset),
# never keys or workspace ids.

set -euo pipefail

dir="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-status"
mkdir -p "$dir"
b="$HOME/.local/share/oclimits"
out=$(XDG_CONFIG_HOME=$b/config XDG_DATA_HOME=$b/data XDG_STATE_HOME=$b/state XDG_CACHE_HOME=$b/cache \
    opencode api experimental.usage.limits 2>/dev/null) || exit 0
# Budget of the pay-as-you-go workspace (vps-projects): a third instance with
# that workspace's account login, ~/.local/share/oclimits-budget, port 49376.
c="$HOME/.local/share/oclimits-budget"
budget='null'
if [ -d "$c" ]; then
    budget=$(XDG_CONFIG_HOME=$c/config XDG_DATA_HOME=$c/data XDG_STATE_HOME=$c/state XDG_CACHE_HOME=$c/cache \
        opencode api experimental.usage.limits 2>/dev/null |
        jq -c '[.data.budgets[]? | select(.scope == "combined" or .per == "set")][0] // .data.budgets[0]?
               | if . then {spent, limit, resets_at: ((.resetsAt // 0) / 1000 | floor)} else null end' 2>/dev/null) || budget='null'
    [ -n "$budget" ] || budget='null'
fi
jq -c --argjson now "$(date +%s)" --argjson budget "$budget" '
    .data.go // empty
    | {at: $now} + (with_entries(.value |= {percent, limited, resets_at: ((.resetsAt // 0) / 1000 | floor)})) + {budget: $budget}
' <<<"$out" > "$dir/limits.json.tmp" && [ -s "$dir/limits.json.tmp" ] && mv -f "$dir/limits.json.tmp" "$dir/limits.json"
