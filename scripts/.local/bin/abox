#!/usr/bin/env bash
# abox [--dry-run] [--] AGENT [ARGS...]: run a coding agent (OpenCode, pi,
# Hermes, or any other command) in a bubblewrap sandbox, started in a git
# worktree or in a plain project folder. `lead start` runs its workers as
# `abox opencode ...` and `abox pi ...`; Hermes starts as `abox hermes`.
#
# The agents' own permission rules only cover their own tools: a shell
# command they run could still read and write anything the user can. A box
# has two parts:
#
#   The shared box, the same for every agent: the whole system read-only;
#   writable only the project (in a git repo the worktree, the repo's git dir
#   for commits, the main checkout's tickets/ for a worker's report),
#   ~/.cache (hmail's mailboxes among them), a scratch folder
#   (~/.local/tmp/abox, the box's TMPDIR) and a private /tmp. Hidden (an
#   empty file or folder in their place): the Claude login, SSH keys, the
#   GitHub CLI login, dclaude's token, the password store, ~/.gnupg,
#   OpenCode's service password, herdr's sockets and ~/.config/herdr
#   (homelab H-17: through them a worker ran `herdr pane run` in any pane,
#   outside the box), the Docker sockets and the system bus; XDG_RUNTIME_DIR
#   is an empty private folder. The network stays: the model APIs need it.
#
#   A profile per agent, picked by the command's name: its own state folder
#   writable (sessions, settings, its provider login), and what herdr needs
#   from it. Every other agent's state is hidden, so a boxed Hermes can't
#   read OpenCode's or pi's sessions and keys, nor the other way round. A
#   command without a profile (`abox bash`) gets the shared box only, with
#   all agents' state hidden.
#
#     opencode  ~/.local/share/opencode, ~/.local/state/opencode; herdr relay
#     pi        ~/.pi; herdr relay
#     hermes    ~/.hermes; refuses to start next to an unboxed Hermes daemon
#
# Workers report to their lead with `hmail send`, which only writes a file
# in ~/.cache/hmail; hmail's daemon, outside, types it in. OpenCode's and
# pi's status reports to herdr go through abox-herdr-relay, which forwards
# only those, for this pane, with a resume command through abox.
#
# Not covered: every agent reads its own provider key to work (OpenCode's in
# its database in ~/.local/share/opencode, pi's ~/.pi/agent/auth.json,
# Hermes' ~/.hermes/.env). Revoke a key at its provider if an agent ever misbehaves.
# Claude's transcripts (~/.claude/projects) stay readable to every box.

set -euo pipefail

dry=
[ "${1:-}" = --dry-run ] && { dry=1; shift; }
[ "${1:-}" = -- ] && shift
(( $# )) || { echo "usage: abox [--dry-run] [--] AGENT [ARGS...]" >&2; exit 2; }
command -v bwrap >/dev/null || { echo "abox: bwrap is missing (pacman -S bubblewrap)" >&2; exit 1; }
agent=$(basename "$1")

args=(--ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --die-with-parent)
rw() { [ -e "$1" ] || mkdir -p "$1"; args+=(--bind "$1" "$1"); }
hide() {
    if [ -d "$1" ]; then args+=(--tmpfs "$1")
    elif [ -e "$1" ]; then args+=(--ro-bind /dev/null "$1")
    fi
}

# --- The shared box -------------------------------------------------------

# The project. In a git repo: the worktree, the shared git dir (commits from
# a worktree) and the main checkout's tickets/ (a worker's report). Outside
# one: just this folder, but never the home folder or anything above it,
# which would open all of it. The project comes first among the binds:
# hermes_guard reads it back from a box's bwrap command line.
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
    common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
    main=$(dirname "$common")
    rw "$top"
    rw "$common"
    [ -d "$main/tickets" ] && rw "$main/tickets"
else
    top=$(pwd -P)
    case "$(cd "$HOME" && pwd -P)/" in
        "$top"/*) echo "abox: run it in a project folder, not in $top (that would make all of your home writable)" >&2; exit 1 ;;
    esac
    rw "$top"
fi
rw "$HOME/.cache"
# The scratch folder, the box's TMPDIR (the login's ~/.local/tmp is
# read-only here; tests use it through os.tmpdir()).
scratch=$HOME/.local/tmp/abox
rw "$scratch"

# XDG_RUNTIME_DIR gets an empty private tmpfs, not the real one: that holds
# the user bus (bus) and the user manager (systemd/private), through which
# `systemd-run --user` starts a unit outside the box that reads anything,
# the gh token and the Docker socket included (homelab H-15); also the
# gpg-agent's SSH socket and other tools' daemons (herdr-core's too).
# Nothing a boxed agent needs lives there: tools that keep sockets there
# (agent-browser) start their own in here.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    args+=(--perms 0700 --tmpfs "$XDG_RUNTIME_DIR")
fi

# An editor started in the box (Hermes' ctrl-g, pi's external editor) is
# nvim, which writes its state (shada, logs, swap) and harpoon's marks on
# exit and errors on a read-only home. Give it writable throwaway copies:
# a tmpfs overlay over the real folders, so it reads plugins and config as
# usual and nothing it writes reaches the host (bwrap 0.10+).
if bwrap --help 2>&1 | grep -q -- --tmp-overlay; then
    for d in "$HOME/.local/state/nvim" "$HOME/.local/share/nvim"; do
        [ -d "$d" ] && args+=(--overlay-src "$d" --tmp-overlay "$d")
    done
fi

hide "$HOME/.claude/.credentials.json"
hide "$HOME/.ssh"
hide "$HOME/.config/gh"
hide "$HOME/.config/dclaude"
hide "$HOME/.password-store"
hide "$HOME/.gnupg"
hide "$HOME/.config/opencode/service.json"
hide /run/docker.sock   # /var/run is a link to /run
# herdr: its server and client sockets, its logs and session file, and the
# link to gpg-agent's SSH socket all live here (homelab H-17).
hide "$HOME/.config/herdr"
# A rootless Docker socket would be in XDG_RUNTIME_DIR, which is empty here.
unset DOCKER_HOST
# The system bus: nothing an agent runs needs it (homelab H-15).
hide /run/dbus/system_bus_socket
# Both point into the real XDG_RUNTIME_DIR (the user bus, and gpg-agent's
# SSH socket through herdr's link), so they would only dangle.
unset DBUS_SESSION_BUS_ADDRESS SSH_AUTH_SOCK

# --- The agent's profile --------------------------------------------------

# Hermes runs its agent, tools included, in one background daemon (its
# "gateway") per Hermes home, shared by every hermes client and started by
# the first one. A boxed client that found a daemon started outside abox (a
# plain `hermes`, `hermes chat`) would hand it the work unsandboxed; one from
# another box would run it with that box's writable folder. So start Hermes
# here only when no daemon runs, or when it runs in a box of this same folder.
hermes_guard() {
    local home=${HERMES_HOME:-$HOME/.hermes} pid p prev line box=
    pid=$(jq -r '.pid // empty' "$home/gateway.pid" 2>/dev/null) || return 0
    [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] || return 0
    tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q 'gateway run' || return 0   # stale pid file
    p=$pid
    while [ "${p:-1}" -gt 1 ]; do
        if [ "$(basename "$(head -zn1 "/proc/$p/cmdline" 2>/dev/null | tr -d '\0')")" = bwrap ]; then
            # The box's folder is the first --bind after --ro-bind / / and the
            # /dev, /proc, /tmp ones: the repo top or plain folder.
            prev=
            while IFS= read -r -d '' line; do
                [ "$prev" = --bind ] && { box=$line; break; }
                prev=$line
            done <"/proc/$p/cmdline"
            break
        fi
        p=$(ps -o ppid= -p "$p" | tr -d ' ')
    done
    # The daemon outlives the client that started it: once that box's bwrap
    # exits, the daemon is reparented to init but still runs in the box's
    # mount namespace. Then the box's folder is the first mount point only
    # that namespace has (abox binds it before anything else).
    if [ -z "$box" ] && [ "$(readlink "/proc/$pid/ns/mnt")" != "$(readlink /proc/self/ns/mnt)" ]; then
        box=$(awk 'NR == FNR { host[$5]; next }
                   $5 ~ /^\/(dev|proc|sys|tmp|run)(\/|$)/ { next }
                   !($5 in host) { print $5; exit }' \
            /proc/self/mountinfo "/proc/$pid/mountinfo" 2>/dev/null)
    fi
    if [ -z "$box" ]; then
        echo "abox: a Hermes daemon (pid $pid) runs outside the sandbox, and this Hermes would use it." >&2
        echo "      Close the Hermes sessions outside abox, or stop it: hermes gateway stop" >&2
        exit 1
    fi
    if [ "$box" != "$top" ]; then
        echo "abox: the Hermes daemon (pid $pid) runs in the box of $box; this Hermes would work there, not in $top." >&2
        echo "      Start it in $box, or close the Hermes sessions there first." >&2
        exit 1
    fi
}

want_relay=
case $agent in
    opencode)
        rw "$HOME/.local/share/opencode"
        rw "$HOME/.local/state/opencode"
        want_relay=1 ;;
    pi)
        [ -d "$HOME/.pi" ] && rw "$HOME/.pi"
        want_relay=1 ;;
    hermes)
        [ -d "$HOME/.hermes" ] && rw "$HOME/.hermes"
        [ -z "$dry" ] && hermes_guard ;;
esac
# Every other agent's state is hidden, not only read-only: it holds that
# agent's provider key, its sessions and tokens such as Hermes' Discord bot
# token in ~/.hermes/.env, which a worker could otherwise read and use.
[ "$agent" = opencode ] || { hide "$HOME/.local/share/opencode"; hide "$HOME/.local/state/opencode"; }
[ "$agent" = pi ] || hide "$HOME/.pi"
[ "$agent" = hermes ] || hide "$HOME/.hermes"

# herdr inside the box: no socket at all, except abox-herdr-relay's, which
# forwards only pane.report_agent and pane.report_agent_session for this
# pane (OpenCode's and pi's status). It runs outside the box, listening in a
# private folder that is bound into the box's own /tmp, and stops with abox.
# It adds a resume command through abox to every session it forwards: herdr's
# own (`opencode --session ID`) resumed the worker unboxed after a restart.
# Hermes has no such integration (herdr reads its screen), so it gets none.
relay_dir= relay_pid=
relay_sock=/tmp/abox-herdr/relay.sock
upstream=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
unset HERDR_SOCKET_PATH HERDR_BIN_PATH
if [ -n "$want_relay" ] && [ -n "${HERDR_PANE_ID:-}" ] && [ -S "$upstream" ]; then
    if [ -n "$dry" ]; then
        args+=(--bind /RELAY-DIR /tmp/abox-herdr)
        export HERDR_SOCKET_PATH=$relay_sock
    else
        relay_dir=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" abox-herdr.XXXXXX)
        # The box's command too: herdr resumes the pane through abox with it.
        ABOX_HERDR_UPSTREAM=$upstream "$(dirname "$(readlink -f "$0")")/abox-herdr-relay" "$relay_dir/relay.sock" \
            "$HERDR_PANE_ID" -- "$@" </dev/null &
        relay_pid=$!
        trap 'kill "$relay_pid" 2>/dev/null; rm -rf "$relay_dir"' EXIT
        for _ in {1..50}; do [ -S "$relay_dir/relay.sock" ] && break; sleep 0.1; done
        if [ -S "$relay_dir/relay.sock" ]; then
            args+=(--bind "$relay_dir" /tmp/abox-herdr)
            export HERDR_SOCKET_PATH=$relay_sock
        else
            echo "abox: abox-herdr-relay didn't start; herdr gets no status from this box" >&2
        fi
    fi
fi

# --- Environment and start ------------------------------------------------

# herdr recognises an agent typed into a pane by HERDR_AGENT (as for dclaude):
# the command's name, which is the herdr kind for opencode, pi and hermes.
export HERDR_AGENT=${HERDR_AGENT:-$agent}
# agent-browser's profile defaults to terminal-browser's own, read-only
# folder: one per project in the scratch folder, so parallel workers never
# share a browser profile (it locks).
export TMPDIR=$scratch
export AGENT_BROWSER_PROFILE="$scratch/browser/$(basename "$top")"
mkdir -p "$AGENT_BROWSER_PROFILE"
if [ -n "$dry" ]; then
    printf '%q ' bwrap "${args[@]}" --chdir "$PWD" "$@"; echo
    exit 0
fi
# Without a relay nothing needs to run after the box: exec, as before.
[ -n "$relay_pid" ] || exec bwrap "${args[@]}" --chdir "$PWD" "$@"
bwrap "${args[@]}" --chdir "$PWD" "$@"
