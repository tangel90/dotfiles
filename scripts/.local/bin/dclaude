#!/usr/bin/env bash
# dclaude [--rebuild] [--new] [claude args...]: run Claude Code inside this
# project's devcontainer, still reporting to the herdr pane it was started from.
# Without claude args it continues the project's latest container session, if
# there is one; --new starts fresh instead.
#
# herdr learns about a Claude session through the SessionStart hook in
# ~/.claude (installed by `herdr integration install claude`), which writes to
# $HERDR_SOCKET_PATH tagged with $HERDR_PANE_ID. So the container needs:
#   - the socket's directory mounted (the dir, not the socket: herdr recreates
#     the socket on server restart and a file mount would keep the dead one)
#   - ~/.claude at the SAME path, because settings.json calls the hook by its
#     absolute host path; CLAUDE_CONFIG_DIR points the container's claude at it
#   - the HERDR_* vars, passed per exec since the pane id differs per pane
#   - python3 and the host uid inside the container (socket is mode 0600)
#
# The container's ~/.claude is its own (~/.local/share/dclaude/claude), with
# host config copied in and only the login mounted through. Sharing the whole dir
# mixed both sides' session registries, daemon and jobs — the container listed
# host agents it could not reach. Agents talk across that boundary through
# herdr instead: its binary and skill are provided, and the socket is mounted
# anyway. Note the socket can also run commands in host panes, so this is
# isolation of files, not a security boundary.
#
# Mounts are only applied when the container is created — use --rebuild after
# changing them, or on a project whose container predates dclaude.
#
# Projects without their own devcontainer config use $DCLAUDE_CONFIG, default
# ~/.config/devcontainer/default/devcontainer.json (stowed from tools/devcontainer).

set -euo pipefail

up_args=()
new=
while [ $# -gt 0 ]; do
    case $1 in
        --rebuild) up_args+=(--remove-existing-container) ;;
        --new) new=1 ;;
        *) break ;;
    esac
    shift
done

ws=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Every devcontainer call must get the same --config: the CLI finds an existing
# container by workspace folder *and* config path.
dc_args=(--workspace-folder "$ws")
if [ ! -f "$ws/.devcontainer/devcontainer.json" ] && [ ! -f "$ws/.devcontainer.json" ]; then
    default=${DCLAUDE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/devcontainer/default/devcontainer.json}
    if [ ! -f "$default" ]; then
        echo "dclaude: $ws has no devcontainer config and $default is missing (stow -d tools -t ~ devcontainer)" >&2
        exit 1
    fi
    dc_args+=(--config "$default")
fi

sock=${HERDR_SOCKET_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock}
data=${XDG_DATA_HOME:-$HOME/.local/share}/dclaude
state=$data/claude
bin=$data/bin
mkdir -p "$state/skills" "$bin"

# The devcontainer CLI's --mount has no readonly option, and anything mounted
# writable from the host is a way back out: an edited hook or a swapped binary
# runs on the host next time. So host config and binaries are copied in fresh
# each run instead, and the container only ever changes its copies.

# Host config. -L because some of these are stow symlinks into the dotfiles
# repo, which isn't mounted.
for name in settings.json CLAUDE.md keybindings.json hooks output-styles themes statusline-command.sh; do
    rm -rf "${state:?}/$name"
    if [ -e "$HOME/.claude/$name" ]; then cp -RL "$HOME/.claude/$name" "$state/$name"; fi
done

# Default to the flicker-free fullscreen renderer unless the host settings pick
# one. claude would persist the choice itself, but into this copy, which the
# next run overwrites — so it would ask again every time.
python3 - "$state/settings.json" <<'PY'
import json, sys

path = sys.argv[1]
try:
    with open(path) as f:
        settings = json.load(f)
except OSError:
    settings = {}
settings.setdefault("tui", "fullscreen")
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
PY

# Versions are immutable, so copy (~200MB) only when it changes.
host_claude=$(readlink -f "$(command -v claude)")
claude_bin=claude-$(basename "$host_claude")
if [ ! -x "$bin/$claude_bin" ]; then
    find "$bin" -maxdepth 1 -name 'claude-*' -delete
    cp "$host_claude" "$bin/$claude_bin.tmp" && mv "$bin/$claude_bin.tmp" "$bin/$claude_bin"
fi

if command -v herdr >/dev/null; then
    # Static binary, runs in any image.
    cmp -s "$(command -v herdr)" "$bin/herdr" || cp -L "$(command -v herdr)" "$bin/herdr"
    # Regenerated each run so it matches the installed herdr.
    mkdir -p "$state/skills/herdr"
    herdr --skill >"$state/skills/herdr/SKILL.md"
fi

mounts=(
    --mount "type=bind,source=$state,target=$HOME/.claude"
    --mount "type=bind,source=$bin,target=/opt/dclaude/bin"
    --mount "type=bind,source=$(dirname "$sock"),target=/herdr"
)

# The one deliberate write-through: a token refresh inside the container must
# reach the host, or the next refresh on either side fails.
if [ -f "$HOME/.claude/.credentials.json" ]; then
    touch "$state/.credentials.json"
    mounts+=(--mount "type=bind,source=$HOME/.claude/.credentials.json,target=$HOME/.claude/.credentials.json")
fi

devcontainer up "${dc_args[@]}" "${up_args[@]}" "${mounts[@]}" >/dev/null

# Continue the latest session by default, like `claude -c`, but only when there
# is one: -c with nothing to continue exits instead of starting fresh. The
# container's sessions live in its own state, under the in-container cwd
# (/workspaces/<project>) with every non-alphanumeric character turned into -.
# A project config with a custom workspaceFolder never matches, so starts fresh.
if [ $# -eq 0 ] && [ -z "$new" ]; then
    project=$(printf '/workspaces/%s' "$(basename "$ws")" | sed 's/[^A-Za-z0-9]/-/g')
    if compgen -G "$state/projects/$project/*.jsonl" >/dev/null; then
        set -- --continue
    fi
fi

# claude keeps its global state (account, theme, onboarding, trusted folders)
# in $CLAUDE_CONFIG_DIR/.claude.json, not ~/.claude.json — without this it
# starts as a fresh install. Seed it from the host file each run; a copy rather
# than a mount, so the container never writes the host's file. Host keys win;
# keys only the container has (prompt counters, folders trusted under
# /workspaces/...) are kept, or every one-time prompt comes back each run.
if [ -f "$HOME/.claude.json" ]; then
    python3 - "$HOME/.claude.json" "$state/.claude.json" <<'PY'
import json, os, sys

host, seeded = sys.argv[1:]
with open(host) as f:
    cfg = json.load(f)
try:
    with open(seeded) as f:
        prev = json.load(f)
except (OSError, ValueError):
    prev = {}
projects = {**prev.get("projects", {}), **cfg.get("projects", {})}
cfg = {**prev, **cfg, "projects": projects}

tmp = seeded + ".dclaude-tmp"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    json.dump(cfg, f, indent=2)
os.replace(tmp, seeded)
PY
fi

# The herdr hook silently no-ops on either of these, so say it up front.
devcontainer exec "${dc_args[@]}" sh -c '
    command -v python3 >/dev/null || echo "dclaude: no python3 in container, herdr will not see this session" >&2
    [ "$(id -u)" = "$1" ] || echo "dclaude: container uid $(id -u) != host uid $1, herdr socket is unreachable" >&2
' sh "$(id -u)"

# Claude's Bash sandbox keeps commands away from the herdr socket: it can type
# into host panes, so anything reaching it can run commands on the host. Hooks
# and the status line run outside the sandbox and keep reporting through it;
# only Bash loses it. bubblewrap needs user namespaces, which Docker's default
# seccomp profile forbids — the default devcontainer runs with
# seccomp-userns.json for that; a project's own config needs the same runArgs.
# Without them, run unsandboxed and say so rather than break every command.
if devcontainer exec "${dc_args[@]}" sh -c 'command -v bwrap && command -v socat && unshare -U true' >/dev/null 2>&1; then
    sandbox=1
else
    sandbox=
    echo "dclaude: no sandbox in this container (needs bwrap, socat and user namespaces, see seccomp-userns.json); Bash can reach the herdr socket" >&2
fi
python3 - "$state/settings.json" "$sandbox" <<'PY'
import json, sys

path, sandbox = sys.argv[1:]
with open(path) as f:
    settings = json.load(f)
if sandbox:
    settings["sandbox"] = {
        **settings.get("sandbox", {}),
        "enabled": True,
        # bubblewrap can't mount a fresh /proc in an unprivileged container
        "enableWeakerNestedSandbox": True,
        # no retrying a blocked command outside the sandbox
        "allowUnsandboxedCommands": False,
        "failIfUnavailable": True,
        # the herdr socket's directory, see the mounts above
        "filesystem": {"denyRead": ["/herdr"]},
    }
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
PY

# DCLAUDE tells hooks they're in a container: herdr-worktree.py falls back to
# plain git, since worktrees herdr creates live on host paths not mounted here.
env_args=(--remote-env "CLAUDE_CONFIG_DIR=$HOME/.claude" --remote-env DCLAUDE=1)
# docker exec sets TERM=xterm and no COLORTERM, so claude assumes 16 colours
# and rounds the theme's colours to the nearest basic one (rose -> white).
env_args+=(--remote-env "TERM=${TERM:-xterm-256color}" --remote-env "COLORTERM=${COLORTERM:-truecolor}")
if [ "${HERDR_ENV:-}" = 1 ]; then
    env_args+=(
        --remote-env HERDR_ENV=1
        --remote-env "HERDR_SOCKET_PATH=/herdr/$(basename "$sock")"
        --remote-env "HERDR_PANE_ID=$HERDR_PANE_ID"
        --remote-env "HERDR_TAB_ID=${HERDR_TAB_ID:-}"
        --remote-env "HERDR_WORKSPACE_ID=${HERDR_WORKSPACE_ID:-}"
    )
fi
# Set in herdr panes by .zshrc: keep the container's claude in this pane too,
# rather than in a background service of its own.
if [ -n "${CLAUDE_CODE_DISABLE_AGENT_VIEW:-}" ]; then
    env_args+=(--remote-env "CLAUDE_CODE_DISABLE_AGENT_VIEW=$CLAUDE_CODE_DISABLE_AGENT_VIEW")
fi

# Docker doesn't stop an exec'd process when its client goes away, so closing
# the tab would leave claude running in the container: holding memory and API
# connections, and racing a later resume of the same conversation. Each run
# tags its container processes with DCLAUDE_RUN, which also shows in the host's
# devcontainer exec command line. A detached watcher stops this run's tagged
# processes once this script (exec'd into devcontainer, same pid) is gone,
# however it ends: herdr kills a closed tab's processes too fast for an exit
# trap. And before starting, tagged processes whose host side is gone are
# stopped too, in case a watcher died.
run_id=$(date +%s%N)-$$
env_args+=(--remote-env "DCLAUDE_RUN=$run_id")
cid=$(docker ps -q --filter "label=devcontainer.local_folder=$ws" | head -n1)
# shellcheck disable=SC2016  # expanded in the container
stop_tagged='
    mode=$1 ids=" $2 "
    for env in /proc/[0-9]*/environ; do
        id=$(tr "\0" "\n" <"$env" 2>/dev/null | sed -n "s/^DCLAUDE_RUN=//p")
        [ -n "$id" ] || continue
        case $mode:$ids in
            keep:*" $id "*) continue ;;
            only:*" $id "*) ;;
            only:*) continue ;;
        esac
        pid=${env#/proc/}; kill -TERM "${pid%/environ}" 2>/dev/null
    done'
if [ -n "$cid" ]; then
    live=$(pgrep -af -- '--remote-env DCLAUDE_RUN=' | grep -o 'DCLAUDE_RUN=[0-9-]*' | cut -d= -f2 | tr '\n' ' ' || true)
    docker exec -u "$(id -u)" "$cid" sh -c "$stop_tagged" sh keep "$live" >/dev/null 2>&1 || true
    setsid -f sh -c '
        while kill -0 "$1" 2>/dev/null; do sleep 2; done
        docker exec -u "$2" "$3" sh -c "$4" sh only "$5"
    ' sh $$ "$(id -u)" "$cid" "$stop_tagged" "$run_id" </dev/null >/dev/null 2>&1
fi

# The pane's foreground process is devcontainer (node), which hides claude from
# herdr's process detection. HERDR_AGENT on that host-side wrapper tells herdr
# to apply claude's screen manifest to it anyway — setting it inside the
# container would not be visible to herdr.
export HERDR_AGENT=claude

# Prefer the image's own claude; the host binary needs glibc (no alpine).
# /opt/dclaude/bin goes on PATH for herdr; claude there is versioned, so it
# never shadows the image's own. Custom themes are read from ~/.claude/themes,
# not $CLAUDE_CONFIG_DIR, and the container's HOME is the image user's — so
# link them there, or claude falls back to the base theme.
exec devcontainer exec "${dc_args[@]}" "${env_args[@]}" sh -c '
    host=$1; shift
    PATH=/opt/dclaude/bin:$PATH; export PATH
    if [ "$HOME/.claude" != "$CLAUDE_CONFIG_DIR" ] && [ -d "$CLAUDE_CONFIG_DIR/themes" ]; then
        mkdir -p "$HOME/.claude" && ln -sfn "$CLAUDE_CONFIG_DIR/themes" "$HOME/.claude/themes"
    fi
    if command -v claude >/dev/null; then exec claude "$@"; fi
    exec "$host" "$@"
' sh "/opt/dclaude/bin/$claude_bin" "$@"
