#!/usr/bin/env bash
# dclaude [--rebuild] [claude args...]: run Claude Code inside this project's
# devcontainer, still reporting to the herdr pane it was started from.
#
# herdr learns about a Claude session through the SessionStart hook in
# ~/.claude (installed by `herdr integration install claude`), which writes to
# $HERDR_SOCKET_PATH tagged with $HERDR_PANE_ID. So the container needs:
#   - the socket's directory mounted (the dir, not the socket: herdr recreates
#     the socket on server restart and a file mount would keep the dead one)
#   - ~/.claude at the SAME path, because settings.json calls the hook by its
#     absolute host path; CLAUDE_CONFIG_DIR points the container's claude at it
#   - the HERDR_* vars, passed per exec since the pane id differs per pane
#   - python3 and the host uid inside the container (socket is mode 0600)
#
# The container's ~/.claude is its own (~/.local/share/dclaude/claude), with
# only config and the login mounted in from the host. Sharing the whole dir
# mixed both sides' session registries, daemon and jobs — the container listed
# host agents it could not reach. Agents talk across that boundary through
# herdr instead: its binary and skill are provided, and the socket is mounted
# anyway. Note the socket can also run commands in host panes, so this is
# isolation of files, not a security boundary.
#
# Mounts are only applied when the container is created — use --rebuild after
# changing them, or on a project whose container predates dclaude.
#
# Projects without their own devcontainer config use $DCLAUDE_CONFIG, default
# ~/.config/devcontainer/default/devcontainer.json (stowed from tools/devcontainer).

set -euo pipefail

up_args=()
if [ "${1:-}" = --rebuild ]; then
    up_args+=(--remove-existing-container)
    shift
fi

ws=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Every devcontainer call must get the same --config: the CLI finds an existing
# container by workspace folder *and* config path.
dc_args=(--workspace-folder "$ws")
if [ ! -f "$ws/.devcontainer/devcontainer.json" ] && [ ! -f "$ws/.devcontainer.json" ]; then
    default=${DCLAUDE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/devcontainer/default/devcontainer.json}
    if [ ! -f "$default" ]; then
        echo "dclaude: $ws has no devcontainer config and $default is missing (stow -d tools -t ~ devcontainer)" >&2
        exit 1
    fi
    dc_args+=(--config "$default")
fi

sock=${HERDR_SOCKET_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock}
state=${XDG_DATA_HOME:-$HOME/.local/share}/dclaude/claude
mkdir -p "$state/skills"

# Mount the whole versions dir rather than the resolved binary, so a host-side
# `claude update` doesn't leave the container pinned to a deleted file.
host_claude=$(readlink -f "$(command -v claude)")
host_claude_share=$(dirname "$(dirname "$host_claude")")
container_claude=/opt/host-claude/versions/$(basename "$host_claude")

mounts=(
    --mount "type=bind,source=$state,target=$HOME/.claude"
    --mount "type=bind,source=$(dirname "$sock"),target=/herdr"
    --mount "type=bind,source=$host_claude_share,target=/opt/host-claude"
)

# Host config, read-only over the container's own dir. readlink -f because some
# of these are stow symlinks into the dotfiles repo, which isn't mounted.
for name in settings.json CLAUDE.md keybindings.json hooks statusline-command.sh; do
    src=$HOME/.claude/$name
    [ -e "$src" ] || continue
    src=$(readlink -f "$src")
    # Mount targets inside a bind mount get created on the host side; make them
    # with the right type up front.
    if [ -d "$src" ]; then mkdir -p "$state/$name"; else touch "$state/$name"; fi
    mounts+=(--mount "type=bind,source=$src,target=$HOME/.claude/$name,readonly")
done

# Writable, so a token refresh inside the container reaches the host too.
if [ -f "$HOME/.claude/.credentials.json" ]; then
    touch "$state/.credentials.json"
    mounts+=(--mount "type=bind,source=$HOME/.claude/.credentials.json,target=$HOME/.claude/.credentials.json")
fi

if command -v herdr >/dev/null; then
    # Static binary, runs in any image.
    mounts+=(--mount "type=bind,source=$(readlink -f "$(command -v herdr)"),target=/usr/local/bin/herdr,readonly")
    # Regenerated each run so it matches the installed herdr.
    mkdir -p "$state/skills/herdr"
    herdr --skill >"$state/skills/herdr/SKILL.md"
fi

devcontainer up "${dc_args[@]}" "${up_args[@]}" "${mounts[@]}" >/dev/null

# claude keeps its global state (account, theme, onboarding, trusted folders)
# in $CLAUDE_CONFIG_DIR/.claude.json, not ~/.claude.json — without this it
# starts as a fresh install. Seed it from the host file each run; a copy rather
# than a mount, so the container never writes the host's file. Folders trusted
# inside the container (/workspaces/...) are kept across runs.
if [ -f "$HOME/.claude.json" ]; then
    python3 - "$HOME/.claude.json" "$state/.claude.json" <<'PY'
import json, os, sys

host, seeded = sys.argv[1:]
with open(host) as f:
    cfg = json.load(f)
try:
    with open(seeded) as f:
        projects = json.load(f).get("projects", {})
except (OSError, ValueError):
    projects = {}
cfg["projects"] = {**cfg.get("projects", {}), **projects}

tmp = seeded + ".dclaude-tmp"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    json.dump(cfg, f, indent=2)
os.replace(tmp, seeded)
PY
fi

# The herdr hook silently no-ops on either of these, so say it up front.
devcontainer exec "${dc_args[@]}" sh -c '
    command -v python3 >/dev/null || echo "dclaude: no python3 in container, herdr will not see this session" >&2
    [ "$(id -u)" = "$1" ] || echo "dclaude: container uid $(id -u) != host uid $1, herdr socket is unreachable" >&2
' sh "$(id -u)"

env_args=(--remote-env "CLAUDE_CONFIG_DIR=$HOME/.claude")
if [ "${HERDR_ENV:-}" = 1 ]; then
    env_args+=(
        --remote-env HERDR_ENV=1
        --remote-env "HERDR_SOCKET_PATH=/herdr/$(basename "$sock")"
        --remote-env "HERDR_PANE_ID=$HERDR_PANE_ID"
        --remote-env "HERDR_TAB_ID=${HERDR_TAB_ID:-}"
        --remote-env "HERDR_WORKSPACE_ID=${HERDR_WORKSPACE_ID:-}"
    )
fi

# Prefer the image's own claude; the host binary needs glibc (no alpine).
exec devcontainer exec "${dc_args[@]}" "${env_args[@]}" sh -c '
    host=$1; shift
    if command -v claude >/dev/null; then exec claude "$@"; fi
    exec "$host" "$@"
' sh "$container_claude" "$@"
