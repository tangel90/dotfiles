#!/usr/bin/env python3
"""ht: ticket board, a filterable list of the repo-lead tickets on this machine.
On prefix+t (a herdr popup in the pane's directory), and listed in hrun
(prefix+shift+r) as "tickets".

Tickets are the files tickets/<P>-<NNN>-<slug>.md that repo-lead (or a sprint
hub) keeps, in the format of the tickets skill
(tools/claude/.claude/skills/tickets/SKILL.md); ht reads their
"# <ID> <title>", "Status:" and "Owner:" lines. Repos are the open herdr
workspaces' roots plus ~/*/ and ~/projects/*/ when they have a tickets/ folder.

The query filters; every word must match:

    !x     status: the first of these names starting with x
           active (default: not done or wontfix), all, triage (needs-triage
           and needs-info), review, ready (ready-for-agent and
           ready-for-human), progress (in-progress), human (ready-for-human),
           closed (done and wontfix), done, wontfix
           so !r review, !rea ready, !t triage, !h human, !c closed,
           !a active, !al all
    @x     owner contains x            #x   repo contains x
    #.     only the repo of the pane ht was opened from
    >14d   last action more than 14 days ago (<3d: less than 3 days)
    word   ID or title contains it (case-insensitive)

Columns after the status: last action and created, as ages (3d), from the
newest and oldest dated Comment ("- YYYY-MM-DD who: ..."). A ticket without
a dated Comment shows its file's modification age instead, marked "~"
(renames and the Jira mirror touch files, so it is a guess).

The board starts in key mode, like herdr's prefix+g popup: j/k move, single
keys set the filter (h human, t triage, r review, p progress, a active,
c closed, l all; m toggles only mine, o toggles last action over 14 days;
. toggles the repo of the pane ht was opened from, w cycles through the repos
with tickets, listed in the header), q or esc quits. / switches to search:
type the query, esc goes back to key mode; # does the same with "#" typed,
for a repo name. Filters combine.

Keys in both modes: enter read the ticket in nvim · ctrl-s start · ctrl-x reject (asks
for a reason) · ctrl-d done, on your own tickets only (Owner thomas; asks for
a note: what was done, which commit) · ctrl-g go to the owner agent (or the
lead) · ctrl-/ show or hide the Brief section.

Start, reject and done never edit the ticket: they prompt the repo's lead (the
herdr agent in that repo whose name ends in "-lead"), which owns the state and
records the decision in the ticket's Comments.

    ht list [QUERY]       ht task FILE       ht act start|drop|done|focus FILE
    ht query KEY [QUERY]  the query after a filter key (used by the board)
"""

import json
import os
import re
import shlex
import subprocess
import sys
from datetime import date
from pathlib import Path

HOME = Path.home()
ORDER = ["needs-triage", "needs-info", "ready-for-human", "ready-for-agent", "in-progress", "review", "done", "wontfix"]
VIEWS = {  # order decides which name a !prefix picks
    "active": set(ORDER[:6]),
    "all": set(ORDER),
    "triage": {"needs-triage", "needs-info"},
    "review": {"review"},
    "ready": {"ready-for-agent", "ready-for-human"},
    "progress": {"in-progress"},
    "human": {"ready-for-human"},
    "closed": {"done", "wontfix"},
    "done": {"done"},
    "wontfix": {"wontfix"},
}
TICKET = re.compile(r"^[A-Z][A-Z0-9]*-\d+-.*\.md$")
COLOR = {"needs-triage": "35", "needs-info": "35", "ready-for-human": "33", "ready-for-agent": "33",
         "in-progress": "36", "review": "34", "done": "2", "wontfix": "2"}
SELF = shlex.quote(str(Path(__file__).resolve()))
HELP = ("j/k move · h human · t triage · r review · p progress · a active · c closed · l all · m mine · o >14d\n"
        ". this repo · w next repo · # repo search · / search · q quit\n"
        "enter read · ctrl-s start · ctrl-x reject · ctrl-d done (yours) · ctrl-g agent · ctrl-/ brief")
STATUS_KEYS = {"h": "!human", "t": "!triage", "r": "!review", "p": "!progress", "a": "", "c": "!closed", "l": "!all"}
OLD = ">14d"
MODE_KEYS = "j,k,q,/,#,.,w,m,o," + ",".join(STATUS_KEYS)
DATED = re.compile(r"^- (\d{4}-\d{2}-\d{2})\b")


def human_names():
    """Owner values that mean the human: thomas/human, the login and git first name."""
    names = {"human", "thomas", os.environ.get("USER", "").lower()}
    try:
        out = subprocess.run(["git", "config", "user.name"], capture_output=True, text=True).stdout.split()
        names.update(n.lower() for n in out[:1])
    except OSError:
        pass
    return names - {""}


def age(day):
    return f"{max(0, (date.today() - day).days)}d"


def herdr(*args):
    try:
        out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout)["result"]
    except Exception:
        return {}


def repos():
    roots = set()
    for ws in herdr("workspace", "list").get("workspaces", []):
        wt = ws.get("worktree") or {}
        for key in ("repo_root", "checkout_path"):
            if wt.get(key):
                roots.add(Path(wt[key]))
    for pattern in ("*/tickets", "projects/*/tickets"):
        roots.update(p.parent for p in HOME.glob(pattern) if p.is_dir())
    return sorted(r for r in roots if (r / "tickets").is_dir())


def parse(path):
    t = {"path": path, "id": "-".join(path.stem.split("-", 2)[:2]), "title": path.stem, "status": "?", "owner": ""}
    try:
        lines = path.read_text(errors="replace").splitlines()
        mtime = date.fromtimestamp(path.stat().st_mtime)
    except OSError:
        return None
    dates, section = [], ""
    for line in lines:
        if line.startswith("## "):
            section = line[3:].strip().lower()
        elif section == "comments" and (m := DATED.match(line)):
            try:
                dates.append(date.fromisoformat(m.group(1)))
            except ValueError:
                pass
    t["last"], t["created"], t["guess"] = (max(dates), min(dates), False) if dates else (mtime, mtime, True)
    heading = False
    for line in lines[:12]:
        key, _, value = line.partition(":")
        if line.startswith("# ") and not heading:
            heading = True
            tid, _, title = line[2:].strip().partition(" ")
            t["id"], t["title"] = tid, title or t["title"]
        elif key.lower() == "status" and value.strip():
            t["status"] = value.split()[0].lower()
        elif key.lower() == "owner":
            t["owner"] = value.strip()
    return t


def repo_of(path):
    try:
        out = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        top = Path(out.stdout.strip()) if out.returncode == 0 else None
    except OSError:
        top = None
    # A worktree under .claude/worktrees/ belongs to the main checkout's tickets.
    if top and ".claude/worktrees" in str(top):
        top = Path(str(top).split("/.claude/worktrees")[0])
    return top


def matcher(query):
    """Turn the query into a predicate on a ticket, plus the status set in use."""
    statuses, tests = VIEWS["active"], []
    for word in query.lower().split():
        sigil, rest = word[0], word[1:]
        if sigil == "!":
            name = next((v for v in VIEWS if v.startswith(rest)), None)
            statuses = VIEWS[name] if name else set()
        elif sigil == "@":
            tests.append(lambda t, r=rest: r in t["owner"].lower())
        elif sigil == "#" and rest == ".":
            here = repo_of(os.environ.get("HERDR_ACTIVE_PANE_CWD") or os.getcwd())
            tests.append(lambda t, h=here: h is not None and t["root"].resolve() == h.resolve())
        elif sigil == "#":
            tests.append(lambda t, r=rest: r in t["repo"].lower())
        elif sigil in "<>" and re.fullmatch(r"\d+d?", rest):
            n = int(rest.rstrip("d"))
            if sigil == ">":
                tests.append(lambda t, n=n: (date.today() - t["last"]).days > n)
            else:
                tests.append(lambda t, n=n: (date.today() - t["last"]).days < n)
        else:
            tests.append(lambda t, w=word: w in t["id"].lower() or w in t["title"].lower())
    active = statuses is VIEWS["active"]
    return lambda t: (t["status"] in statuses or (active and t["status"] not in ORDER)) and all(f(t) for f in tests)


def cmd_list(query):
    keep = matcher(query)
    rows = []
    for root in repos():
        for p in sorted((root / "tickets").glob("*.md")):
            if not TICKET.match(p.name):
                continue
            t = parse(p)
            if t:
                t["root"], t["repo"] = root, root.name
                if keep(t):
                    rows.append(t)
    rank = {s: i for i, s in enumerate(ORDER)}
    rows.sort(key=lambda t: (rank.get(t["status"], -1), t["repo"], t["id"]))
    if not rows:
        print(f"\t(no tickets match: {query or '!active'})")
    rw = max((len(t["repo"]) for t in rows), default=0)
    iw = max((len(t["id"]) for t in rows), default=0)
    for t in rows:
        st = f"\033[{COLOR.get(t['status'], '31')}m{t['status']:<15}\033[0m"
        owner = f"  \033[2m@{t['owner']}\033[0m" if t["owner"] and t["owner"] != "lead" else ""
        mark = "~" if t["guess"] else " "
        ages = f"\033[2m{mark}{age(t['last']):>4} {mark}{age(t['created']):>4}\033[0m"
        print(f"{t['path']}\t{t['repo']:<{rw}}  {t['id']:<{iw}}  {st}  {ages}  {t['title']}{owner}")


def cmd_task(argv):
    """Print the ticket's header lines and its Brief (or older Task) section, not the Comments."""
    try:
        lines = Path(argv[0]).read_text(errors="replace").splitlines()
    except (IndexError, OSError):
        return
    out, section = [], "header"
    for line in lines:
        if line.startswith("## "):
            section = line[3:].strip().lower()
            continue
        if section in ("header", "brief", "task"):
            out.append(line)
    print("\n".join(out).strip())


def agents():
    return herdr("agent", "list").get("agents", [])


def lead_for(root):
    for a in agents():
        name = a.get("name") or ""
        cwd = a.get("cwd") or ""
        if name.endswith("-lead") and (cwd == str(root) or cwd.startswith(str(root) + "/")):
            return name
    return None


def say(msg):
    print(msg)
    try:
        subprocess.run(["sleep", "1.5"])
    except KeyboardInterrupt:
        pass


def cmd_act(argv):
    if len(argv) != 2 or argv[0] not in ("start", "drop", "done", "focus"):
        sys.exit("usage: ht act start|drop|done|focus FILE")
    action, path = argv[0], Path(argv[1])
    if not path.is_file():
        return say("no ticket selected")
    t = parse(path)
    root = path.parent.parent
    lead = lead_for(root)
    if action == "focus":
        names = {a.get("name") for a in agents()}
        target = t["owner"] if t["owner"] in names else lead
        if target:
            herdr("agent", "focus", target)
        else:
            say(f"no agent for {t['id']} and no *-lead running in {root}")
        return
    if action == "done" and t["owner"].lower() not in human_names():
        return say(f"{t['id']} is owned by {t['owner'] or 'nobody'}, not you: ctrl-d only closes your own tickets")
    if not lead:
        return say(f"no *-lead agent running in {root}; start one there with: ha --host {root.name}-lead --agent repo-lead")
    if action == "start":
        msg = f"[{t['id']}] human: start this ticket ({path}). Note the decision in its Comments."
    elif action == "done":
        with open("/dev/tty") as tty:
            print(f"Done {t['id']} {t['title']}\nnote, what was done and which commit (empty cancels): ", end="", flush=True)
            note = tty.readline().strip()
        if not note:
            return say("cancelled")
        msg = f"[{t['id']}] human: done ({note}) ({path}). Set Status done and record it in Comments."
    else:
        with open("/dev/tty") as tty:
            print(f"Reject {t['id']} {t['title']}\nreason (empty cancels): ", end="", flush=True)
            reason = tty.readline().strip()
        if not reason:
            return say("cancelled")
        msg = f"[{t['id']}] human: drop this ticket ({path}), reason: {reason}. Set Status wontfix and note it in its Comments."
    res = herdr("agent", "prompt", lead, msg)
    say(f"sent to {lead}" if res else f"could not prompt {lead}")


def cmd_query(argv):
    """Print the query a filter key turns QUERY into: status keys replace the
    !token, m toggles @<you>, o toggles >14d; other words stay."""
    key, words = (argv[0] if argv else ""), (" ".join(argv[1:])).split()
    me = "@" + next(iter(sorted(n for n in human_names() if n != "human")), "thomas")
    if key in STATUS_KEYS:
        words = [w for w in words if not w.startswith("!")] + ([STATUS_KEYS[key]] if STATUS_KEYS[key] else [])
    elif key == "m":
        words = [w for w in words if w != me] if me in words else words + [me]
    elif key == "o":
        words = [w for w in words if w != OLD] if OLD in words else words + [OLD]
    elif key == ".":
        here = "#." in words
        words = [w for w in words if not w.startswith("#")] + ([] if here else ["#."])
    elif key == "w":
        names = sorted({r.name for r in repos()})
        cur = next((w[1:] for w in words if w.startswith("#") and w != "#."), None)
        words = [w for w in words if not w.startswith("#")]
        nxt = names[0] if cur not in names else (names[names.index(cur) + 1] if names.index(cur) + 1 < len(names) else None)
        if names and nxt:
            words.append("#" + nxt)
    elif key == "#":
        words = [w for w in words if not w.startswith("#")] + ["#"]
    print(" ".join(words))


def cmd_header(query):
    """The key map plus the repos with tickets, the one in the query marked."""
    words = query.split()
    cur = next((w[1:] for w in words if w.startswith("#") and w not in ("#", "#.")), None)
    names = sorted({r.name for r in repos()})
    shown = "this pane's repo" if "#." in words else " ".join(f"[{n}]" if n == cur else n for n in names) or "(none)"
    print(f"{HELP}\nrepos: {shown}")


def board():
    # --disabled: fzf doesn't filter; every keystroke reloads `ht list {q}`.
    # Key mode until / (the prompt shows the mode): its keys are unbound for
    # search and rebound by esc, which quits from key mode.
    reload = f"reload({SELF} list {{q}})"
    header = f"transform-header({SELF} header {{q}})"
    filters = [f"{k}:transform-query({SELF} query {k} {{q}})+{reload}+{header}" for k in [*STATUS_KEYS, "m", "o", ".", "w"]]
    esc = (f'[ "$FZF_PROMPT" = "search> " ] && echo "rebind({MODE_KEYS})+change-prompt(tickets> )" || echo abort')
    subprocess.run(
        ["fzf", "--height=100%", "--ansi", "--disabled", "--delimiter", "\t", "--with-nth", "2", "--no-sort",
         "--layout", "reverse", "--prompt", "tickets> ", "--header", HELP,
         "--preview", f"test -f {{1}} && {SELF} task {{1}}", "--preview-window", "down,40%,wrap,hidden",
         "--bind", f"start:{reload}+{header}", "--bind", f"change:{reload}+{header}",
         "--bind", "j:down", "--bind", "k:up", "--bind", "q:abort",
         *[x for f in filters for x in ("--bind", f)],
         "--bind", f"/:unbind({MODE_KEYS})+change-prompt(search> )",
         "--bind", f"#:unbind({MODE_KEYS})+change-prompt(search> )+transform-query({SELF} query '#' {{q}})+{reload}+{header}",
         "--bind", f"esc:transform:{esc}",
         "--bind", "ctrl-/:toggle-preview",
         "--bind", "enter:execute(test -f {1} && nvim -R {1})",
         "--bind", f"ctrl-s:execute({SELF} act start {{1}})+{reload}",
         "--bind", f"ctrl-x:execute({SELF} act drop {{1}})+{reload}",
         "--bind", f"ctrl-d:execute({SELF} act done {{1}})+{reload}",
         "--bind", f"ctrl-g:execute-silent({SELF} act focus {{1}})+abort"],
        input="",
    )


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["list"]:
        cmd_list(" ".join(argv[1:]))
    elif argv[:1] == ["task"]:
        cmd_task(argv[1:])
    elif argv[:1] == ["act"]:
        cmd_act(argv[1:])
    elif argv[:1] == ["query"]:
        cmd_query(argv[1:])
    elif argv[:1] == ["header"]:
        cmd_header(" ".join(argv[1:]))
    elif not argv:
        board()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
