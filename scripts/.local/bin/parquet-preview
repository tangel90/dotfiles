#!/bin/sh
# Compact parquet summary for a terminal pane: row count, schema, first rows.
#
# Used as the yazi previewer for *.parquet (via piper.yazi — see yazi.toml), and
# useful standalone: `parquet-preview f.parquet | less -S`.
#
# duckdb reads parquet with no extension to autoload (unlike json), so this works
# offline and needs nothing beyond the duckdb binary. Row count comes from the
# footer metadata, so it stays fast on large files.
#
# Schema is printed one column per line rather than as a wide table: yazi's
# preview pane is narrow, and a 100-column file is unreadable side-by-side.
#
# WIDTH is passed to .maxwidth, but duckdb only honours it when stdout is a tty,
# so the trailing sample rows of a wide table simply get clipped by the pane.
# The schema list above them is the part that always stays readable.
set -eu

f=${1:?usage: parquet-preview FILE [WIDTH]}
w=${2:-120}

# SQL string literal: single quotes, doubled to escape.
q=$(printf '%s' "$f" | sed "s/'/''/g")

exec duckdb -box \
    -c ".maxwidth $w" \
    -c "SELECT count(*) AS rows, (SELECT count(*) FROM (DESCRIBE FROM read_parquet('$q'))) AS columns FROM read_parquet('$q')" \
    -c "SELECT column_name AS column, column_type AS type FROM (DESCRIBE FROM read_parquet('$q'))" \
    -c "SELECT * FROM read_parquet('$q') LIMIT 10"
