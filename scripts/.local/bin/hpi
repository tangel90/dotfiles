#!/usr/bin/env bash
# hpi [--workspace ID] [--continue] [NAME]: start the pi team's repo lead in this repo's
# main checkout, as the herdr agent NAME (default <repo>-lead, which ht's
# ctrl-s looks for), in a new tab (of workspace ID, for callers without a pane
# of their own, like hagent's popup). The pi counterpart of hoc and of
# `ha --host <repo>-lead --agent repo-lead`.
#
# pi has no agent definitions, so the lead is ~/.pi/agent/roles/repo-lead.md
# (generated by agents-gen), appended to pi's system prompt; its header holds
# the model and thinking level. Not in abox: the lead pushes and opens pull requests through
# `lead ship`. Its workers are pi agents, started by `lead start`.
# --continue resumes the lead's last pi session in this folder instead of a
# fresh conversation.
#
# --team ID puts this repo on another pi team from teams.toml (a [pi-ID]
# table): hpi links .pi/team to ~/.pi/agent/teams/ID (generated by
# agents-gen), takes the lead from there, and `lead start` takes the workers'
# models and roles from the same folder. The choice stays until
# `--team default` (or `--team go`, the default team's name) removes the link;
# without --team, hpi keeps the repo's team. .pi/team is kept out of git.

set -euo pipefail

usage="usage: hpi [--workspace ID] [--team ID|default] [--continue] [NAME]"
ws=() resume=() team=
while [ $# -gt 0 ]; do
    case $1 in
        --workspace) ws=(--workspace "${2:?hpi: --workspace needs an ID}"); shift 2 ;;
        --team) team=${2:?hpi: --team needs an ID}; shift 2 ;;
        --continue|-c) resume=(--continue); shift ;;
        -*) echo "$usage" >&2; exit 2 ;;
        *) break ;;
    esac
done

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "hpi: run it in a git repo" >&2; exit 1; }
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || { echo "hpi: run it in the main checkout, not a worktree" >&2; exit 1; }
name=${1:-$(basename "$top")-lead}
cd "$top"

teams=$HOME/.pi/agent/teams
case $team in
    '') ;;
    default|go) rm -f .pi/team ;;
    *) [ -f "$teams/$team/repo-lead.md" ] || {
           echo "hpi: no team $team in $teams (have: default $(ls "$teams" 2>/dev/null | tr '\n' ' '))" >&2; exit 1; }
       mkdir -p .pi
       ln -sfn "$teams/$team" .pi/team
       exclude="$(git rev-parse --git-common-dir)/info/exclude"
       grep -qx '.pi/team' "$exclude" 2>/dev/null || echo '.pi/team' >> "$exclude" ;;
esac
if [ -L .pi/team ]; then
    role=$top/.pi/team/repo-lead.md
    echo "hpi: team $(basename "$(readlink .pi/team)")"
else
    role=$HOME/.pi/agent/roles/repo-lead.md
    echo "hpi: default pi team"
fi
[ -f "$role" ] || { echo "hpi: $role is missing (stow tools/pi, run agents-gen)" >&2; exit 1; }
field() { sed -n '2,/^---$/{s/^'"$1"': *//p}' "$role" | head -n1; }
model=$(field model)
thinking=$(field thinking)

args=(--model "$model")
[ -n "$thinking" ] && args+=(--thinking "$thinking")
args+=(--append-system-prompt "$role")

exec ha --host "${ws[@]}" --kind pi "$name" "${args[@]}" "${resume[@]}"
