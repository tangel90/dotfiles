#!/usr/bin/env bash
# hoc [--workspace ID] [--continue | --session ID] [NAME]: start the OpenCode
# repo lead in this repo's main
# checkout, as the herdr agent NAME (default <repo>-lead, which ht's ctrl-s
# looks for), in a new tab (of workspace ID, for callers without a pane of
# their own, like hagent's popup). The OpenCode counterpart of
# `ha --host <repo>-lead --agent repo-lead`.
#
# OpenCode has no --agent flag, so the agent comes from the repo's
# .opencode/opencode.jsonc (default_agent repo-lead), which hoc writes and
# keeps out of git. The agent file ~/.config/opencode/agents/repo-lead.md holds
# its model and full instructions (generated by agents-gen). It runs
# --standalone, off OpenCode's shared background service, and not in abox:
# the lead pushes and opens pull requests through `lead ship`.
#
# --continue resumes the lead's last OpenCode session in this folder,
# --session ID a given one, instead of a fresh conversation; the agent file
# and the herdr name are set up as for a fresh start.
#
# --team ID puts this repo on another OpenCode team from teams.toml: it links
# .opencode/agents to ~/.config/opencode/teams/ID (generated by agents-gen),
# whose agent files override the global ones in this folder, and `lead start`
# gives every worker's worktree the same link. The choice stays until
# `--team default` removes the link; without --team, hoc keeps the repo's team.

set -euo pipefail

usage="usage: hoc [--workspace ID] [--team ID|default] [--continue | --session ID] [NAME]"
ws=() resume=() team=
while [ $# -gt 0 ]; do
    case $1 in
        --workspace) ws=(--workspace "${2:?hoc: --workspace needs an ID}"); shift 2 ;;
        --team) team=${2:?hoc: --team needs an ID}; shift 2 ;;
        --continue|-c) resume=(--continue); shift ;;
        --session|-s) resume=(--session "${2:?hoc: --session needs an ID}"); shift 2 ;;
        -*) echo "$usage" >&2; exit 2 ;;
        *) break ;;
    esac
done

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "hoc: run it in a git repo" >&2; exit 1; }
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || { echo "hoc: run it in the main checkout, not a worktree" >&2; exit 1; }
name=${1:-$(basename "$top")-lead}
cd "$top"

mkdir -p .opencode
teams="$HOME/.config/opencode/teams"
if [ -e .opencode/agents ] && [ ! -L .opencode/agents ] && [ -n "$team" ]; then
    echo "hoc: .opencode/agents is a folder of this repo's own, not a team link; leaving it" >&2; exit 1
fi
case $team in
    '') ;;
    default) rm -f .opencode/agents ;;
    *) [ -f "$teams/$team/repo-lead.md" ] || {
           echo "hoc: no team $team in $teams (have: $(ls "$teams" 2>/dev/null | tr '\n' ' '))" >&2; exit 1; }
       ln -sfn "$teams/$team" .opencode/agents ;;
esac
if [ -L .opencode/agents ]; then
    echo "hoc: team $(basename "$(readlink .opencode/agents)")"
else
    echo "hoc: default OpenCode team"
fi
jq -n '{default_agent: "repo-lead"}' > .opencode/opencode.jsonc
exclude="$(git rev-parse --git-common-dir)/info/exclude"
grep -qx '.opencode/' "$exclude" 2>/dev/null || echo '.opencode/' >> "$exclude"

exec ha --host "${ws[@]}" --kind opencode "$name" --standalone "${resume[@]}"
