#!/usr/bin/env bash
# hagent: pick an agent definition with fzf and start it as its own herdr
# agent in a new tab, run from the pane's directory. Bound to prefix+shift+a
# as a popup in herdr's config.toml.
#
# Tab cycles the engine, shown in the prompt: claude, opencode, pi, hermes. For
# Claude, enter starts the agent through dclaude (the project's
# devcontainer), alt-enter as plain host claude without a sandbox, e.g. for
# workflow-agent, which reads host scripts and herdr. Claude lists the user's
# agents (~/.claude/agents) and the project's (<repo>/.claude/agents),
# OpenCode its own (~/.config/opencode/agents). OpenCode's repo lead starts
# through hoc; any other OpenCode agent (implementer, reviewer, debugger)
# starts in the abox sandbox in this repo or worktree, with no lead (it
# reports only as a ticket Comment): OpenCode has no --agent flag, so hagent
# writes <repo>/.opencode/opencode.jsonc (default_agent, the Claude
# definition as instructions), as `lead start` does. The agent is named after
# the definition, numbered if that name is taken; repo-lead is named
# <repo>-lead, the name ht's ctrl-s looks for. pi and Hermes have no agent
# definitions: each lists one entry, with the default model from its own
# settings, and starts in abox in this repo, worktree or plain folder (named
# pi / hermes).

set -euo pipefail

engines=(claude opencode pi hermes)

# name <TAB> model <TAB> scope <TAB> description <TAB> file <TAB> engine;
# name, model and description from the frontmatter, the file name when
# there's no name.
list() {
    local engine=$1 d scope f root
    local dirs=() model
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    case $engine in
        pi)
            f="$HOME/.pi/agent/settings.json"
            model=$(jq -r '.defaultModel // "-"' "$f" 2>/dev/null || echo -)
            printf 'pi\t%s\tuser\tpi coding agent, sandboxed in abox in this repo\t%s\tpi\n' "$model" "$f"
            return ;;
        hermes)
            f="$HOME/.hermes/config.yaml"
            model=$(awk '/^model:/ { m = 1; next } m && /^[^ #]/ { exit } m && /^  (default|model):/ { sub(/^  [a-z]+:[ \t]*/, ""); gsub(/"/, ""); print; exit }' "$f" 2>/dev/null)
            printf 'hermes\t%s\tuser\tHermes Agent, sandboxed in abox in this repo\t%s\thermes\n' "${model##*/}" "$f"
            return ;;
    esac
    if [ "$engine" = opencode ]; then
        dirs=("$HOME/.config/opencode/agents")
    else
        dirs=("$HOME/.claude/agents")
        [ -n "$root" ] && dirs+=("$root/.claude/agents")
    fi
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        case $d in "$root"/*) scope=project ;; *) scope=user ;; esac
        for f in "$d"/*.md; do
            [ -e "$f" ] || continue
            awk -v f="$f" -v scope="$scope" -v engine="$engine" '
                NR == 1 && $0 != "---" { exit }
                NR > 1 && $0 == "---" { exit }
                /^name:/ { sub(/^name:[ \t]*/, ""); name = $0 }
                /^model:/ { sub(/^model:[ \t]*/, ""); model = $0 }
                /^description:/ { sub(/^description:[ \t]*/, ""); desc = $0 }
                END {
                    if (name == "") { name = f; sub(/.*\//, "", name); sub(/\.md$/, "", name) }
                    sub(/.*\//, "", model)
                    printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, (model == "" ? "-" : model), scope, desc, f, engine
                }' "$f"
        done
    done
}

if [ "${1:-}" = --list ]; then
    list "${2:-claude}"
    exit 0
fi

# Tab: the next engine after the one in fzf's prompt.
if [ "${1:-}" = --next ]; then
    cur=${FZF_PROMPT%> }
    next=${engines[0]}
    for i in "${!engines[@]}"; do
        [ "${engines[$i]}" = "$cur" ] && next=${engines[$(( (i + 1) % ${#engines[@]} ))]}
    done
    echo "change-prompt($next> )+reload($0 --list $next)"
    exit 0
fi

here=${HERDR_ACTIVE_PANE_CWD:-$PWD}
cd "$here"

out=$(list "${engines[0]}" | fzf --height=100% --delimiter='\t' --with-nth=1,2,3,4 \
    --prompt "${engines[0]}> " --header 'tab: claude/opencode/pi/hermes · claude: enter dclaude, alt-enter host' \
    --bind "tab:transform:$0 --next" --expect=alt-enter \
    --preview 'bat --color=always --style=plain {5}' --preview-window=down,60%) || exit 0
key=$(head -1 <<<"$out")
line=$(sed -n 2p <<<"$out")
[ -n "$line" ] || exit 0
agent=$(cut -f1 <<<"$line")
engine=$(cut -f6 <<<"$line")

if [ "$agent" = repo-lead ] && root=$(git rev-parse --show-toplevel 2>/dev/null); then
    want=$(basename "$root")-lead
else
    want=$agent
fi

# herdr's rule for agent names, see ha.
base=$(tr '[:upper:]' '[:lower:]' <<<"$want" | tr -c 'a-z0-9_\n-' '-')
[[ $base =~ ^[a-z] ]] || base=a-$base
base=${base:0:29}
name=$base
agents=$(herdr agent list)
n=1
while jq -e --arg n "$name" '.result.agents[] | select(.name == $n)' <<<"$agents" >/dev/null; do
    name=$base$((++n))
done

# ha wants HERDR_ENV, which popups don't get (as in hp); in a popup the active
# workspace stands in for the caller's pane, run from a shell ha finds its own.
ws=()
[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ] && ws=(--workspace "$HERDR_ACTIVE_WORKSPACE_ID")

# hoc runs on the host (OpenCode's lead isn't sandboxed: it ships).
if [ "$engine" = opencode ] && [ "$agent" = repo-lead ]; then
    HERDR_ENV=1 exec "$HOME/.local/bin/hoc" "${ws[@]}" "$name"
fi
if [ "$engine" = opencode ]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "hagent: OpenCode workers start in a git repo or worktree" >&2; read -rn1; exit 1; }
    instr="$HOME/.claude/agents/$agent.md"
    [ -f "$instr" ] || { echo "hagent: no Claude definition $instr for OpenCode's $agent" >&2; read -rn1; exit 1; }
    cd "$top"
    mkdir -p .opencode
    jq -n --arg a "$agent" --arg f "$instr" '{default_agent: $a, instructions: [$f]}' > .opencode/opencode.jsonc
    exclude="$(git rev-parse --git-common-dir)/info/exclude"
    grep -qx '.opencode/' "$exclude" 2>/dev/null || echo '.opencode/' >> "$exclude"
    HERDR_ENV=1 exec "$HOME/.local/bin/ha" --host "${ws[@]}" --kind opencode --typed "$name" abox opencode --standalone
fi
if [ "$engine" = pi ] || [ "$engine" = hermes ]; then
    # abox makes the repo writable, or outside one just this folder.
    top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top"
    HERDR_ENV=1 exec "$HOME/.local/bin/ha" --host "${ws[@]}" --kind "$engine" --typed "$name" abox "$engine"
fi
flags=()
[ "$key" = alt-enter ] && flags+=(--host)
HERDR_ENV=1 exec "$HOME/.local/bin/ha" "${flags[@]}" "${ws[@]}" "$name" --agent "$agent"
