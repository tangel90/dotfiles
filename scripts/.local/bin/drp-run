#!/usr/bin/env bash
# drp-run [-s SERVICE] ENV -- CMD [ARGS...]: run CMD with the DRP web service
# credentials of ENV (LOCAL, DEV, DEV2, TEST, PROD) from pass, in CMD's
# environment only: nothing is written to disk or printed. For Thomas to run;
# agents are denied it (and pass) in the user settings and only write the
# command.
#
# pass layout, one entry per env and service (lowercase env):
#   drp/<env>/<service>    line 1 the password, plus a "user: <name>" line
# e.g. drp/test/pig_patrol (user api-reporting), drp/prod/smorrebrod. Services
# so far: pig_patrol, smorrebrod, gonzo, beaker, fozzie; every entry under
# drp/<env>/ is loaded.
#
# CMD gets:
#   DRP_ENV, DRP_BASE_URL (TEST/PROD only)
#   DRP_<SERVICE>_USER / DRP_<SERVICE>_PASSWORD for every entry of ENV
#   DRP_USER / DRP_PASSWORD from -s SERVICE (default pig_patrol)
#   what the services' own auth modules read, so they run unchanged:
#     smorrebrod-cloud        API_PASSWORD (user api-reporting) from pig_patrol
#     dealstore_deal_adapter  SMORREBROD_<ENV>_USERNAME/_PASSWORD from smorrebrod
#   python: an import hook (~/.local/share/drp-run/python/sitecustomize.py, put
#     first on PYTHONPATH) replaces auth.auth.get_auth, pig_patrol's
#     hard-coded dict, with DRP_USER/DRP_PASSWORD; it refuses any other env
#   curl: DRP_USER/DRP_PASSWORD passed as a curl config on a pipe (-K), so
#     `drp-run TEST -- curl URL` needs no -u and nothing shows in ps
#
# Other commands read the variables themselves; quote so they expand inside,
# not in the calling shell: drp-run TEST -- sh -c 'tool --user "$DRP_USER"'.

set -euo pipefail
set +x

die() { echo "drp-run: $*" >&2; exit 2; }

service=pig_patrol
while [ $# -gt 0 ]; do
    case $1 in
        -s) service=${2:?drp-run: -s needs a service}; shift 2 ;;
        -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) break ;;
    esac
done
[ $# -ge 3 ] && [ "$2" = -- ] || die "usage: drp-run [-s SERVICE] ENV -- CMD [ARGS...]"
env=${1^^}
shift 2
case $env in
    LOCAL|DEV|DEV2|TEST|PROD) ;;
    *) die "ENV must be LOCAL, DEV, DEV2, TEST or PROD, not $env" ;;
esac

store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
entries=("$store/drp/${env,,}"/*.gpg)
[ -e "${entries[0]}" ] || die "no pass entries under drp/${env,,}/"

# Into variables through pipes only: here-strings may use temp files.
for f in "${entries[@]}"; do
    svc=$(basename "$f" .gpg)
    mapfile -t lines < <(pass show "drp/${env,,}/$svc")
    pw=${lines[0]:-}
    user=
    for l in "${lines[@]:1}"; do
        case $l in
            user:*|login:*|username:*) user=${l#*:}; user=${user# }; break ;;
        esac
    done
    [ -n "$pw" ] && [ -n "$user" ] || die "drp/${env,,}/$svc needs a password line and a 'user:' line"
    key=${svc^^}
    key=${key//[^A-Z0-9]/_}
    export "DRP_${key}_USER=$user" "DRP_${key}_PASSWORD=$pw"
done
unset lines pw user

key=${service^^}
key=${key//[^A-Z0-9]/_}
user_var=DRP_${key}_USER pw_var=DRP_${key}_PASSWORD
[ -n "${!user_var:-}" ] || die "no drp/${env,,}/$service entry for -s $service"
export DRP_ENV=$env DRP_USER=${!user_var} DRP_PASSWORD=${!pw_var}
case $env in
    TEST) export DRP_BASE_URL=https://cloudtest.trianel.com ;;
    PROD) export DRP_BASE_URL=https://cloud.trianel.com ;;
esac
[ -z "${DRP_PIG_PATROL_PASSWORD:-}" ] || export API_PASSWORD=$DRP_PIG_PATROL_PASSWORD
if [ -n "${DRP_SMORREBROD_USER:-}" ]; then
    export "SMORREBROD_${env}_USERNAME=$DRP_SMORREBROD_USER" "SMORREBROD_${env}_PASSWORD=$DRP_SMORREBROD_PASSWORD"
fi

export PYTHONPATH="${XDG_DATA_HOME:-$HOME/.local/share}/drp-run/python${PYTHONPATH:+:$PYTHONPATH}"

if [ "$(basename "$1")" = curl ]; then
    q() { local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }
    exec 3< <(printf 'user = "%s:%s"\n' "$(q "$DRP_USER")" "$(q "$DRP_PASSWORD")")
    exec "$1" -K /dev/fd/3 "${@:2}"
fi
exec "$@"
