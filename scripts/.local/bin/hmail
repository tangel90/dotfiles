#!/usr/bin/env python3
"""hmail: messages between herdr agents that never type over the human.

    hmail send NAME TEXT...   leave a one-line message for agent NAME
    hmail take [--hook]       print and clear the mail of the agent in this pane
    hmail list                show waiting mail
    hmail daemon              deliver mail (run as hmail.service)

`herdr agent prompt` types into the agent's input box right away, so a lead
the human is typing to gets the message in the middle of their sentence.
`hmail send` only appends the line to ~/.cache/hmail/NAME (writable from abox
and, as an excluded command, from Claude's sandbox). Two things hand it over:

- the daemon types it into the agent's pane once that is safe: the agent is
  idle or done, and either the human is not on that pane (herdr's focus) or
  the pane has been still for QUIET seconds with an empty input box;
- a Claude agent's UserPromptSubmit hook (`hmail take --hook`) attaches it to
  the human's next prompt, so a message waiting on a focused pane rides along
  with what the human sends.

The input box counts as empty when Claude's `❯` line between the two rules
holds nothing or only dimmed text (its `Try "..."` hint and its suggested
next prompt, such as "merged it, what's next": typed text is never dim), or, for any harness, when the screen is still exactly what it
was when the agent turned idle (nothing was typed since).

Without a running daemon (no heartbeat for 30 s) `send` falls back to
`herdr agent prompt`, as before. Mail is per machine, like herdr's agents.

In abox (homelab H-17) herdr isn't reachable: `send` then only queues the
line, unchecked (no agent list to check the name against, no fallback),
signed HMAIL_FROM or "a boxed agent". Everything in ~/.cache/hmail is
therefore written by untrusted senders, and the daemon, which runs outside
any box, treats it so:

- it opens the folder once (refusing a symlink) and every file in it
  relative to that, without following symlinks, and reads only regular
  files: a link to a secret is neither read nor typed into a pane, and a
  link in place of .lock, .daemon or a mailbox writes nothing elsewhere;
- it delivers only to agents in `herdr agent list`; mail for another name
  waits in its file (`hmail list` shows it);
- it types text only: control and format characters (escape sequences,
  carriage returns, tabs, bidi marks) become spaces, and every delivery
  starts with "[hmail] ", so a line can't start a Claude `!` shell command;
- a line over MAX_LINE characters is cut there and marked "[cut]"; one
  delivery types at most MAX_TYPE characters, and the lines after that go
  in the next round; a mailbox over MAX_BOX bytes is read up to that size
  and the rest dropped, with a note in the mail. `send` refuses a message
  over MAX_LINE characters outright.
"""

import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

MAILDIR = Path.home() / ".cache" / "hmail"
HEARTBEAT = MAILDIR / ".daemon"
POLL = 2  # seconds between daemon rounds
QUIET = 15  # seconds a focused pane must be still before typing into it
NAME_RE = re.compile(r"^[A-Za-z0-9_:-][A-Za-z0-9._:-]*$")  # no dotfiles
MAX_LINE = 2000  # characters in one message
MAX_TYPE = 8000  # characters typed into a pane in one delivery
MAX_BOX = 64 * 1024  # bytes read from one mailbox


# A systemd user service runs with PATH=/usr/local/bin:/usr/bin, without
# ~/.local/bin where herdr is installed; the daemon failed every round there.
HERDR = shutil.which("herdr") or str(Path.home() / ".local/bin/herdr")


def herdr(*args):
    r = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"herdr {args[0]} failed")
    return r.stdout


def agents():
    return json.loads(herdr("agent", "list"))["result"]["agents"]


def own_name(agent_list=None):
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return None
    for a in agent_list if agent_list is not None else agents():
        if a.get("pane_id") == pane:
            return a.get("name") or None
    return None


NOFOLLOW = os.O_NOFOLLOW | os.O_CLOEXEC


def open_maildir():
    """The mail folder as a directory fd, never through a symlink: a boxed
    sender can replace ~/.cache/hmail, but not the folder this fd holds."""
    MAILDIR.mkdir(parents=True, exist_ok=True)
    return os.open(MAILDIR, os.O_RDONLY | os.O_DIRECTORY | NOFOLLOW)


class Locked:
    """One lock for the whole folder: appends and takes never interleave.
    `.dir` is the folder's fd; every file is opened relative to it."""

    def __enter__(self):
        self.dir = open_maildir()
        try:
            self.lock = os.open(".lock", os.O_RDWR | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=self.dir)
        except OSError:  # a link (or a folder) a sender put in its place
            try:
                os.unlink(".lock", dir_fd=self.dir)
            except IsADirectoryError:
                os.rmdir(".lock", dir_fd=self.dir)
            self.lock = os.open(".lock", os.O_RDWR | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=self.dir)
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_):
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        os.close(self.lock)
        os.close(self.dir)


def read_box(dirfd, name):
    """A mailbox's text, at most MAX_BOX bytes of it, or None when it is
    missing or not a regular file (a symlink, a fifo, a folder)."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | NOFOLLOW, dir_fd=dirfd)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        data = f.read(MAX_BOX + 1)
    text = data[:MAX_BOX].decode("utf-8", "replace")
    if len(data) > MAX_BOX:
        text = text.rsplit("\n", 1)[0] + f"\n(hmail: mail for {name} over {MAX_BOX} bytes, the rest was dropped)\n"
    return text


def take(name):
    with Locked() as l:
        text = read_box(l.dir, name)
        try:
            os.unlink(name, dir_fd=l.dir)  # also a link or fifo in its place
        except (FileNotFoundError, IsADirectoryError, PermissionError):
            pass
    return [x for x in (text or "").splitlines() if x.strip()]


def write_box(dirfd, name, text):
    """Replace a mailbox: a new file renamed over it, so a symlink in its
    place is replaced, not followed."""
    tmp = f".{name}.{os.getpid()}"
    try:
        os.unlink(tmp, dir_fd=dirfd)  # left by an earlier run
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=dirfd)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)


def put_back(name, lines):
    with Locked() as l:
        old = read_box(l.dir, name) or ""
        write_box(l.dir, name, "".join(x + "\n" for x in lines) + old)


def append_box(name, line):
    with Locked() as l:
        fd = os.open(name, os.O_WRONLY | os.O_APPEND | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=l.dir)
        with os.fdopen(fd, "a") as f:
            f.write(line + "\n")


def heartbeat():
    """Touch .daemon without following a symlink a sender put there."""
    d = open_maildir()
    try:
        try:
            fd = os.open(".daemon", os.O_WRONLY | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=d)
        except OSError:  # a link or something else in its place
            try:
                os.unlink(".daemon", dir_fd=d)
            except IsADirectoryError:
                os.rmdir(".daemon", dir_fd=d)
            fd = os.open(".daemon", os.O_WRONLY | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=d)
        os.utime(fd)
        os.close(fd)
    finally:
        os.close(d)


def plain(text):
    """Text only: control and format characters (escape sequences, CR,
    tabs, bidi marks) become spaces, then runs of spaces collapse."""
    text = "".join(" " if unicodedata.category(c)[0] == "C" else c for c in text)
    return " ".join(text.split())


def daemon_alive():
    try:
        return time.time() - HEARTBEAT.stat().st_mtime < 30
    except FileNotFoundError:
        return False


def cmd_send(args):
    if len(args) < 2:
        sys.exit("usage: hmail send NAME TEXT...")
    name, text = args[0], " ".join(args[1:])
    text = plain(text)  # one line: a newline would submit early
    if not NAME_RE.match(name):
        sys.exit(f"hmail: bad agent name {name!r}")
    if not text:
        sys.exit("hmail: empty message")
    if len(text) > MAX_LINE:
        sys.exit(f"hmail: message has {len(text)} characters, over {MAX_LINE}; put the details in a file or ticket")
    try:
        alist = agents()
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired):
        alist = None  # no herdr here: in abox, or herdr is down
    if alist is not None and not any(a.get("name") == name for a in alist):
        sys.exit(f"hmail: no agent {name} on this machine (herdr agent list)")
    # HMAIL_FROM names a sender that is no agent, like hpr for the human.
    sender = (own_name(alist) if alist is not None else None) or os.environ.get("HMAIL_FROM") \
        or ("someone" if alist is not None else "a boxed agent")
    line = f"[{time.strftime('%H:%M')}] {plain(sender)[:64]}: {text}"
    if alist is None:
        # abox: herdr isn't reachable, only the mail folder is.
        append_box(name, line)
        if daemon_alive():
            print(f"hmail: queued for {name}, name unchecked: herdr isn't reachable (in abox, or herdr is down); the daemon delivers only to a running agent")
        else:
            print(f"hmail: queued for {name}, but no hmail daemon is running: it waits until hmail.service runs", file=sys.stderr)
        return
    if not daemon_alive():
        herdr("agent", "prompt", name, f"[hmail] {line}")
        print(f"hmail: no daemon running, prompted {name} directly")
        return
    try:
        append_box(name, line)
    except OSError as e:
        # A sandbox that can't write the mail folder (Claude's, unless it
        # allows ~/.cache/hmail) still reaches herdr's socket.
        herdr("agent", "prompt", name, f"[hmail] {line}")
        print(f"hmail: can't write {MAILDIR} ({e.strerror}), prompted {name} directly")
        return
    print(f"hmail: queued for {name}")


def cmd_take(args):
    hook = "--hook" in args
    try:
        name = own_name()
    except Exception:
        name = None
    if not name:
        if hook:
            return
        sys.exit("hmail: this pane has no herdr agent name")
    lines = take(name)
    if not lines:
        return
    if hook:
        print("Messages other agents left for you since your last turn (hmail):")
        print()
    print("\n".join(lines))


def cmd_list(_):
    if not MAILDIR.is_dir():
        return
    d = open_maildir()
    try:
        for name in sorted(os.listdir(d)):
            if name.startswith("."):
                continue
            for l in (read_box(d, name) or "").splitlines():
                print(f"{plain(name)}\t{plain(l)}")
    finally:
        os.close(d)


# --- daemon ---------------------------------------------------------------

# The upper rule can carry the session name: "────── setup-admin ─".
RULE = re.compile(r"^\s*─{4,}.*─\s*$")


SGR = re.compile(r"\x1b\[([0-9;:]*)m")
ESC = re.compile(r"\x1b(\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)|.)")


def strip_ansi(text):
    return ESC.sub("", text)


def all_dim(ansi_line):
    """True when every visible character after the first ❯ is drawn dim
    (SGR 2). Claude dims its suggested next prompt and its hints; what the
    human types is drawn normally."""
    _, sep, line = ansi_line.partition("❯")
    if not sep:
        return False
    dim, pos, seen = False, 0, False
    for m in list(SGR.finditer(line)) + [None]:
        chunk = strip_ansi(line[pos : m.start() if m else len(line)])
        if chunk.replace("\u00a0", " ").strip():
            if not dim:
                return False
            seen = True
        if m is None:
            break
        for code in (m.group(1) or "0").replace(":", ";").split(";"):
            if code in ("", "0", "22"):
                dim = False
            elif code == "2":
                dim = True
        pos = m.end()
    return seen


def claude_input_empty(screen, ansi=None):
    """Claude's input box: the lines between the last two full rules,
    the first starting with ❯. None when the layout isn't recognised.
    ansi, the same screen with colours, lets dimmed text count as empty."""
    lines = screen.splitlines()
    rules = [i for i, l in enumerate(lines) if RULE.match(l)]
    if len(rules) < 2:
        return None
    body = lines[rules[-2] + 1 : rules[-1]]
    if not body or not body[0].lstrip().startswith("❯"):
        return None
    rest = body[0].lstrip()[1:]
    if re.fullmatch(r'\s*Try "[^"]*"\s*', rest) and len(body) == 1:
        return True  # Claude's dimmed suggestion, not typed text
    if ansi is not None and len(body) == 1 and rest.replace("\u00a0", " ").strip():
        prompts = [l for l in ansi.splitlines() if "❯" in l]
        if prompts and all_dim(prompts[-1]):
            return True  # suggested next prompt, drawn dim
    return all(not s.replace(" ", " ").strip() for s in [rest, *body[1:]])


def opencode_input_empty(screen):
    """OpenCode's input box: a column of ┃ lines closed by ╹▀▀▀; the last ┃
    line names the agent and model, the ones above it hold the draft. None
    when the layout isn't recognised."""
    lines = screen.splitlines()
    ends = [i for i, l in enumerate(lines) if re.match(r"^\s*╹▀{8,}", l)]
    if not ends or ends[-1] < 2:
        return None
    i = ends[-1] - 1  # the agent line
    if not lines[i].lstrip().startswith("┃"):
        return None
    draft = []
    i -= 1
    while i >= 0 and lines[i].lstrip().startswith("┃"):
        draft.append(lines[i].lstrip()[1:])
        i -= 1
    if not draft:
        return None
    text = [d.replace("\u00a0", " ").strip() for d in draft]
    text = [t for t in text if t]
    # A fresh OpenCode's dimmed placeholder, not typed text: without this a
    # new OpenCode agent never gets mail (seen in homelab H-17).
    if len(text) == 1 and re.fullmatch(r'Ask anything… "[^"]*"', text[0]):
        return True
    return not text


# A plain rule; pi's modal-editor extension ends its input box's bottom rule
# with a mode label (NORMAL, INSERT), which still counts as a rule.
FULL_RULE = re.compile(r"^\s*─{8,}\s*(?:NORMAL|INSERT)?\s*$")


def pi_input_empty(screen):
    """pi's input box: the lines between the last two plain rules (no prompt
    sign; the path and usage footer follow). None when not recognised."""
    lines = screen.splitlines()
    rules = [i for i, l in enumerate(lines) if FULL_RULE.match(l)]
    if len(rules) < 2:
        return None
    body = lines[rules[-2] + 1 : rules[-1]]
    if not body:
        return None
    return all(not s.replace(" ", " ").strip() for s in body)


BOX_PARSERS = {"claude": claude_input_empty, "opencode": opencode_input_empty, "pi": pi_input_empty}


class Pane:
    def __init__(self):
        self.status = None
        self.idle_screen = None  # screen when the agent turned idle
        self.screen = None
        self.ansi = None  # the same screen with colours
        self.still_since = time.time()


def read_screen(pane_id):
    """The visible screen with colours; strip_ansi gives the text."""
    return herdr("pane", "read", pane_id, "--source", "visible", "--lines", "60", "--format", "ansi")


def input_empty(agent, st):
    """True, False, or None when this harness's box can't be judged."""
    if st.screen is None:
        return None
    parser = BOX_PARSERS.get(agent.get("agent"))
    if parser:
        empty = parser(st.screen, st.ansi) if parser is claude_input_empty else parser(st.screen)
        if empty is not None:
            return empty
    if st.idle_screen is not None:
        return st.screen == st.idle_screen
    return None


def safe_to_type(agent, st, now):
    """Never over a draft: a pane left with half a sentence in it holds it
    whether or not the human is looking at it right now."""
    if agent.get("agent_status") not in ("idle", "done"):
        return False
    empty = input_empty(agent, st)
    if empty is False:
        return False
    if agent.get("focused"):
        return empty is True and now - st.still_since >= QUIET
    return now - st.still_since >= 2 * POLL


def batch(lines):
    """The plain-text lines for one delivery (at most MAX_TYPE characters,
    at least one line) and the raw ones left for the next round."""
    out, size = [], 0
    for i, raw in enumerate(lines):
        l = plain(raw)
        if len(l) > MAX_LINE:
            l = l[:MAX_LINE] + " [cut]"
        if out and size + len(l) > MAX_TYPE:
            return out, lines[i:]
        if l:
            out.append(l)
            size += len(l) + 5
    return out, []


def deliver(name, pane_id):
    lines = take(name)
    if not lines:
        return
    out, rest = batch(lines)
    if rest:
        put_back(name, rest)
    if not out:
        return
    text = "[hmail] " + "  |  ".join(out)
    try:
        herdr("agent", "prompt", pane_id, text)
    except Exception as e:
        put_back(name, lines[: len(lines) - len(rest)])
        print(f"hmail: delivery to {name} failed, kept: {e}", file=sys.stderr)


def mailboxes():
    """Names with waiting mail: non-empty regular files, not followed."""
    d = open_maildir()
    try:
        names = set()
        for n in os.listdir(d):
            if n.startswith("."):
                continue
            try:
                st = os.stat(n, dir_fd=d, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISREG(st.st_mode) and st.st_size:
                names.add(n)
        return names
    finally:
        os.close(d)


def cmd_daemon(_):
    MAILDIR.mkdir(parents=True, exist_ok=True)
    panes = {}
    while True:
        now = time.time()
        try:
            heartbeat()
            boxes = mailboxes()
            alist = agents()
        except Exception as e:
            print(f"hmail: {e}", file=sys.stderr)
            time.sleep(POLL)
            continue
        by_name = {a["name"]: a for a in alist if a.get("name")}
        # Track every agent pane, mail or not: the screen at the idle
        # transition is the baseline for "nothing typed since".
        seen = set()
        for a in alist:
            pid = a["pane_id"]
            seen.add(pid)
            st = panes.setdefault(pid, Pane())
            status = a.get("agent_status")
            # Not on first sight: an agent idle when the daemon starts may
            # already hold a draft, so it gets no baseline.
            turned_idle = st.status is not None and status in ("idle", "done") and st.status not in ("idle", "done")
            if turned_idle or a.get("name") in boxes:
                try:
                    ansi = read_screen(pid)
                    screen = strip_ansi(ansi)
                except Exception:
                    ansi = screen = None
                st.ansi = ansi
                if screen != st.screen:
                    st.screen, st.still_since = screen, now
                if turned_idle:
                    st.idle_screen = screen
            if status not in ("idle", "done"):
                st.idle_screen = None
            st.status = status
        for pid in list(panes):
            if pid not in seen:
                del panes[pid]
        for name in boxes:
            a = by_name.get(name)
            if a and safe_to_type(a, panes[a["pane_id"]], now):
                deliver(name, a["pane_id"])
        time.sleep(POLL)


def main():
    cmds = {"send": cmd_send, "take": cmd_take, "list": cmd_list, "daemon": cmd_daemon}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        sys.exit(__doc__.split("\n\n")[0].split("\n", 1)[1])
    try:
        cmds[sys.argv[1]](sys.argv[2:])
    except RuntimeError as e:
        sys.exit(f"hmail: {e}")


if __name__ == "__main__":
    main()
