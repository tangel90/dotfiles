#!/usr/bin/env bash
# hlimits: print Claude's 5-hour and weekly usage for herdr's tab bar
# (ui.tab_bar_right): the 5-hour window as a bar like the status line's, the
# weekly one, rarely the limit, as plain text, e.g. "████░░░░░░ 42% ↻1h20 · 18% ↻3d".
#
# Claude only hands its rate limits to the status line, so
# statusline-command.sh caches them in claude-limits.json; this reads that
# cache. The numbers are as fresh as the last status line refresh of any
# session, but a window whose reset has passed shows 0%.

set -euo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-limits.json"
[ -r "$cache" ] || exit 0

jq -r --argjson now "$(date +%s)" '
    def left($s): if $s >= 86400 then "\($s / 86400 | floor)d"
                  else "\($s / 3600 | floor)h\($s % 3600 / 60 | floor | tostring | if length < 2 then "0" + . else . end)" end;
    def bar($p): ([$p / 10 | floor, 10] | min) as $n | ("█" * $n) + ("░" * (10 - $n));
    def entry($w; $withbar):
        if $w == null then empty
        else (if ($w.resets_at // 0) <= $now then 0 else $w.used_percentage | round end) as $p
            | (if $withbar then "\(bar($p)) " else "" end) + "\($p)%"
              + (if $p > 0 then " ↻\(left($w.resets_at - $now))" else "" end) end;
    [entry(.five_hour; true), entry(.seven_day; false)] | join(" · ")
' "$cache"
