#!/usr/bin/env bash
# hlimits: print the 5-hour usage windows for herdr's tab bar
# (ui.tab_bar_right), one entry per service with a mark in front:
# ✳ Claude and ◇ OpenCode Go, e.g. "✳ 42% ↻1h20 · ◇ 7% ↻3h05".
# The weekly windows are left out.
#
# Claude only hands its rate limits to the status line, so
# statusline-command.sh caches them in claude-limits.json; this reads that
# cache. The numbers are as fresh as the last status line refresh of any
# session, but a window whose reset has passed shows 0%.

set -euo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-limits.json"

# Each service prints "<mark> <n>% ↻<time left>"; the parts are joined.
render='
    def left($s): if $s >= 86400 then "\($s / 86400 | floor)d"
                  else "\($s / 3600 | floor)h\($s % 3600 / 60 | floor | tostring | if length < 2 then "0" + . else . end)" end;
    def entry($mark; $p; $reset):
        (if ($reset // 0) <= $now then 0 else ($p // 0 | round) end) as $q
        | "\($mark) \($q)%" + (if $q > 0 then " ↻\(left($reset - $now))" else "" end);'
now=$(date +%s)
parts=()

# ✳ Claude: the 5-hour window, cached by statusline-command.sh.
if [ -r "$cache" ]; then
    p=$(jq -r --argjson now "$now" "$render"'
        if .five_hour then entry("✳"; .five_hour.used_percentage; .five_hour.resets_at) else empty end' "$cache")
    [ -n "$p" ] && parts+=("$p")
fi

# ◇ OpenCode Go: the rolling 5-hour window, written on the VPS by oclimits and
# served on the tailnet. The URL is local and untracked (this repo is public):
# ~/.config/hlimits/opencode-url. Fetched at most once a minute; a failed fetch
# keeps the last copy.
url_file="${XDG_CONFIG_HOME:-$HOME/.config}/hlimits/opencode-url"
oc="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-limits.json"
if [ -r "$url_file" ]; then
    if [ ! -e "$oc" ] || [ $(( now - $(stat -c %Y "$oc") )) -ge 60 ]; then
        curl -fsS -m 2 "$(head -1 "$url_file")" -o "$oc.tmp" 2>/dev/null && mv -f "$oc.tmp" "$oc" || { rm -f "$oc.tmp"; touch -c "$oc"; }
    fi
    if [ -s "$oc" ]; then
        p=$(jq -r --argjson now "$now" "$render"'
            if .rolling then entry("◇"; .rolling.percent; .rolling.resets_at) else empty end' "$oc" 2>/dev/null)
        [ -n "$p" ] && parts+=("$p")
        # ◆ the pay-as-you-go budget, once one is set in the Console.
        p=$(jq -r 'if .budget and .budget.limit then
                     "◆ $\(.budget.spent * 100 | round / 100)/$\(.budget.limit | round)" else empty end' "$oc" 2>/dev/null)
        [ -n "$p" ] && parts+=("$p")
    fi
fi

(( ${#parts[@]} )) || exit 0
printf '%s' "${parts[0]}"
for x in "${parts[@]:1}"; do printf ' · %s' "$x"; done
echo
