#!/usr/bin/env bash

if [[ $# -ge 1 ]]; then
    selected=$(fd . "$@" --type d -d 4 --hidden --follow \
        | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
        | fzf --tiebreak=length,index)
else
    selected=$(fd . "$HOME" --type d -d 6 --hidden --follow -E "notes/" -E "tmp/" -E ".password-store" -E "queries/" \
        | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
        | fzf --tiebreak=length,index)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Resolve session name. If selected is inside a git repo, use the repo root's
# basename so subdirs of the same repo collapse onto one session.
if repo_root=$(git -C "$selected" rev-parse --show-toplevel 2>/dev/null); then
    name_dir=$repo_root
else
    repo_root=""
    name_dir=$selected
fi

# Names that describe an environment or a layout slot rather than a project say
# nothing on their own, and worse, several projects own one each — gonzo/prod and
# smorreprod/prod both used to reduce to "prod", so picking the second silently
# attached to the first one's session. Qualify only those with their parent:
#
#   gonzo/prod              -> gonzo-prod
#   dev/snowflake-reporting -> snowflake-reporting
#
# Add to this list as new generic directory names show up.
generic_names="prod production dev develop development test tests testing stage staging qa uat main master src app data seeds target tmp temp current latest"

base_name=$(basename "$name_dir")
if [[ " $generic_names " == *" ${base_name,,} "* ]]; then
    base_name="$(basename "$(dirname "$name_dir")")-$base_name"
fi

# tmux session names can't contain '.' or ':'. Note there is deliberately no
# truncation here any more: the old ${name%%[_-]*} cut "snowflake-reporting" down
# to "snowflake" and would equally have undone the qualification above.
selected_name=$(echo "$base_name" | tr '.:' '__')
tmux_running=$(pgrep tmux)

# OK - tmux is not running
if [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# Last-resort collision guard: two identically named projects under different
# roots still land on one name. Only a *different* directory counts as a
# collision — attaching to the session that already holds this repo is the
# intended behaviour, and it's what makes subdirs of one repo share a session.
dir_identity() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$1"
}

target_identity=$(dir_identity "$selected")

# Read the path out of list-sessions rather than `display-message -t "=name"`:
# the latter returns an empty string for #{session_path} on tmux 3.7b, which
# would make every existing session look like a stranger's.
session_holds_target() { # $1 = session name
    local path
    path=$(tmux list-sessions -F '#{session_name}	#{session_path}' 2>/dev/null \
        | awk -F'\t' -v want="$1" '$1 == want { print $2; exit }')
    [[ -n $path ]] || return 1
    [[ "$(dir_identity "$path")" == "$target_identity" ]]
}

suffix=2
while [[ $suffix -lt 20 ]] \
    && tmux has-session -t="$selected_name" 2>/dev/null \
    && ! session_holds_target "$selected_name"; do
    selected_name="${base_name}-${suffix}"
    ((suffix++))
done

if ! tmux has-session -t="$selected_name" 2> /dev/null; then

    tmux new-session -ds "$selected_name" -c "$selected"
    run_cmd=""
    if [[ -f "$selected/.envrc" ]]; then
        run_cmd=$( (source "$selected/.envrc"; printf '%s\n' "${RUN_COMMAND:-}") )
        if [[ -n $run_cmd ]]; then
          tmux set-environment -t "$selected_name" RUN_COMMAND "$run_cmd"

          run_default_args=$( (source "$selected/.envrc"; printf '%s\n' "${RUN_DEFAULT_ARGS:-}") )
          if [[ -n $run_default_args ]]; then
            tmux set-environment -t "$selected_name" RUN_DEFAULT_ARGS "$run_default_args"
          fi
        else
          echo "No RUN_COMMAND exported."
        fi
    fi

    # Prefer .claude at the repo root (or selected dir if not in a repo).
    # claude_check_dir="${repo_root:-$selected}"
    # if [[ -d "$claude_check_dir/.claude" ]]; then
    #     tmux send-keys -t "$selected_name" "claude" C-m
    if [[ -n "$repo_root" ]]; then
        # NOTE: do NOT auto `git fetch` here. Over an SSH remote with
        # gpg-agent's ssh-support, a locked key makes gpg spawn pinentry inside
        # this freshly-created detached window *while* the sessionizer is doing
        # switch-client — the two race for the pty, corrupting the terminal and
        # crashing the tmux server. Just open nvim; fetch via `lg` (lazygit) or
        # :Git fetch once you're in a stable, attached pane.
        tmux send-keys -t "$selected_name" "nvim" C-m
    elif [[ "$selected_name" == *data || "$selected_name" == "reports" || "$selected_name" == "*seeds" ]]; then
        tmux send-keys -t "$selected_name" "vd" C-m
    fi
fi

if [[ -z "$TMUX" ]]; then
    tmux a -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
