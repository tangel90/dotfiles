#!/usr/bin/env python3
"""sprint: run a multi-agent sprint hub (team-lead + workers), any hub.

    sprint status            live state, pane and session per agent, open tasks
    sprint up [NAME...]      start missing agents (all, or NAME...), resuming
                             their last recorded session where it still exists
    sprint restart NAME [--fresh] [--model M]
                             exit the agent (/exit), close its pane, start it
                             again (resuming unless --fresh; --model for this
                             session only) and record the session
    sprint settings [--check] [NAME...]
                             print each agent's combined settings; --check
                             lists hub rules the shared role sets already cover
    sprint sync [-q]         record changed sessions in sessions.tsv
    sprint init [LABEL]      scaffold a hub in the current folder from the
                             templates (existing files are kept)

The hub is the nearest folder upwards with an agents.tsv (or $SPRINT_HUB):

    agents.tsv    name<TAB>folder<TAB>mode[<TAB>tab[<TAB>dirs]], # comments.
                  folder is relative to the hub or absolute; mode dclaude|host;
                  tab is a herdr tab label to group agents in (ha --tab), may
                  be empty; dirs are extra working dirs, comma-separated,
                  relative to the hub or absolute, passed as --add-dir (host
                  agents only: a container can't see them).
    sessions.tsv  iso-time<TAB>name<TAB>session-id, appended by sync.
    tickets/      one ticket per file (<ID>-<slug>.md): "# ID: title", then
                  Status:/Owner: header lines; open = not done or wontfix.
                  Replaces TASKS.md, which is read only without tickets/.
    TASKS.md      open tasks as "- [ ] ... @name".
    .sprint       key=value: workspace (herdr workspace label, default the
                  hub's folder name).
    .claude/settings.<name>.json
                  settings for that agent only (e.g. {"model": "sonnet"}).

Settings (host agents): sprint combines, in this order, the shared role set
(lead for the row with folder ".", else worker; from
~/.local/share/sprint/roles/, one source for every hub), the hub's
.claude/settings.json (hub-specific rules only) and .claude/settings.<name>.json,
writes the result to ~/.local/state/sprint/<hub>/<name>.json and passes it as
--settings. Lists are united, objects merged, later scalars win. {{HUB_PATH}}
in any of them becomes the hub's absolute path; path rules need it as
Edit(/{{HUB_PATH}}/...) (a // rule is absolute; ./ would resolve from each
agent's own folder, a single / from the generated file's). Changing a
role set or hub file takes effect at the agent's next start (sprint restart).
    .claude/plugins/<plugin>/
                  hub plugins (a .claude-plugin/plugin.json each, e.g. the
                  hub's skills), loaded into every host agent with
                  --plugin-dir. dclaude agents can't see them: the lead acts
                  for them (e.g. updates their tickets).

Agents start through ha in the hub's herdr workspace, created if missing. A
session resumes only if its history is still filed under the agent's folder:
host ~/.claude/projects/<path>/, dclaude its state dir's
projects/-workspaces-<repo>/. Generalises report-data-store's bin/rds.
"""

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

TEMPLATES = Path(os.path.realpath(__file__)).parent.parent / "share" / "sprint" / "templates"
DCLAUDE_STATE = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "dclaude" / "claude"


def die(msg):
    sys.exit(f"sprint: {msg}")


def herdr(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True)
    try:
        return json.loads(out.stdout)
    except ValueError:
        return {}


def snapshot():
    return herdr("api", "snapshot").get("result", {}).get("snapshot", {})


def find_hub():
    if os.environ.get("SPRINT_HUB"):
        return Path(os.environ["SPRINT_HUB"]).resolve()
    here = Path.cwd().resolve()
    for d in (here, *here.parents):
        if (d / "agents.tsv").is_file():
            return d
    die("no agents.tsv here or above (sprint init scaffolds a hub)")


def config(hub):
    conf = {"workspace": hub.name}
    f = hub / ".sprint"
    if f.is_file():
        for line in f.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    return conf


def roster(hub):
    rows = []
    for line in (hub / "agents.tsv").read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        f = line.split("\t")
        if len(f) < 3:
            die(f"agents.tsv: need name, folder and mode: {line!r}")
        name, folder, mode = f[0], f[1], f[2]
        if mode not in ("dclaude", "host"):
            die(f"agents.tsv: {name}: mode must be dclaude or host, not {mode!r}")
        tab = f[3] if len(f) > 3 and f[3] else None
        extra = [(hub / d.strip()).resolve() for d in f[4].split(",") if d.strip()] if len(f) > 4 else []
        rows.append({"name": name, "dir": (hub / folder).resolve(), "folder": folder, "mode": mode, "tab": tab, "extra": extra})
    return rows


def sessions(hub):
    last = {}
    f = hub / "sessions.tsv"
    if f.is_file():
        for line in f.read_text().splitlines():
            parts = line.split("\t")
            if len(parts) >= 3 and not line.startswith("#"):
                last[parts[1]] = parts[2]
    return last


def mangle(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def git_root(path):
    out = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(out.stdout.strip()) if out.returncode == 0 else Path(path)


def history(agent, sid):
    if agent["mode"] == "host":
        base = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects" / mangle(agent["dir"])
    else:
        base = DCLAUDE_STATE / "projects" / mangle(f"/workspaces/{git_root(agent['dir']).name}")
    return (base / f"{sid}.jsonl").is_file()


def live(snap):
    return {a["name"]: a for a in snap.get("agents", []) if a.get("name")}


def sid_of(agent):
    return (agent.get("agent_session") or {}).get("value")


def cmd_sync(hub, quiet=False):
    snap = snapshot()
    if not snap:
        die("herdr is not reachable")
    agents, last = live(snap), sessions(hub)
    changed = []
    for row in roster(hub):
        sid = sid_of(agents.get(row["name"], {}))
        if sid and last.get(row["name"]) != sid:
            changed.append(f"{datetime.now().astimezone().isoformat(timespec='seconds')}\t{row['name']}\t{sid}\n")
    if changed:
        with open(hub / "sessions.tsv", "a") as f:
            f.writelines(changed)
    if not quiet:
        for c in changed:
            print("recorded", c.split("\t")[1], c.split("\t")[2].strip())
        if not changed:
            print("sessions up to date")


ROLES = TEMPLATES.parent / "roles"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "sprint"


def role(row):
    return "lead" if row["folder"] in (".", "./") else "worker"


def merge(a, b):
    if isinstance(a, dict) and isinstance(b, dict):
        out = dict(a)
        for k, v in b.items():
            out[k] = merge(out[k], v) if k in out else v
        return out
    if isinstance(a, list) and isinstance(b, list):
        return a + [x for x in b if x not in a]
    return b


def load_json(path, hub):
    if not path.is_file():
        return {}
    text = path.read_text().replace("{{HUB_PATH}}", str(hub))
    try:
        return json.loads(text)
    except ValueError as e:
        die(f"{path}: {e}")


def agent_settings(hub, row):
    parts = [ROLES / f"{role(row)}.json", hub / ".claude" / "settings.json", hub / ".claude" / f"settings.{row['name']}.json"]
    combined = {}
    for p in parts:
        combined = merge(combined, load_json(p, hub))
    return combined


def write_settings(hub, row):
    out = STATE / mangle(hub).strip("-") / f"{row['name']}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(agent_settings(hub, row), indent=2) + "\n")
    return out


def cmd_settings(hub, args):
    check = "--check" in args
    names = [a for a in args if a != "--check"]
    rows = [r for r in roster(hub) if not names or r["name"] in names]
    if check:
        hub_set = load_json(hub / ".claude" / "settings.json", hub)
        for name in ("lead", "worker"):
            shared = load_json(ROLES / f"{name}.json", hub)
            for kind in ("allow", "ask", "deny"):
                dup = [r for r in hub_set.get("permissions", {}).get(kind, []) if r in shared.get("permissions", {}).get(kind, [])]
                for r in dup:
                    print(f"{kind:<5} {r}    (in {name}.json: remove from the hub's settings.json)")
        return
    for row in rows:
        print(f"== {row['name']} ({role(row)}, {row['mode']})")
        print(json.dumps(agent_settings(hub, row), indent=2))


def cmd_restart(hub, args):
    fresh = "--fresh" in args
    model = None
    if "--model" in args:
        i = args.index("--model")
        model = args[i + 1] if i + 1 < len(args) else die("--model needs a model")
        args = args[:i] + args[i + 2:]
    names = [a for a in args if a != "--fresh"]
    if len(names) != 1:
        die("usage: sprint restart NAME [--fresh] [--model M]")
    name = names[0]
    if name not in {r["name"] for r in roster(hub)}:
        die(f"not in agents.tsv: {name}")
    cmd_sync(hub, quiet=True)
    agent = live(snapshot()).get(name)
    if agent:
        if agent.get("agent_status") == "working":
            die(f"{name} is working; restart it once it's idle")
        pane = agent["pane_id"]
        herdr("agent", "prompt", name, "/exit")
        for _ in range(60):
            time.sleep(0.5)
            if name not in live(snapshot()):
                break
        else:
            print(f"{name}: still up after /exit, closing its pane anyway", file=sys.stderr)
        herdr("pane", "close", pane)
        print(f"{name}: stopped")
    cmd_up(hub, [name], fresh=fresh, model=model)


def open_tickets(d):
    """Open tickets as (owner, line); top-level files only (tickets/rejected/ is history)."""
    out = []
    for f in sorted(d.glob("*.md")):
        head = {}
        title = f.stem
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("## "):
                break
            if line.startswith("# "):
                title = line[2:].strip()
            elif ":" in line:
                k, v = line.split(":", 1)
                head[k.strip().lower()] = v.strip()
        status = head.get("status", "?")
        if status not in ("done", "wontfix"):
            out.append((head.get("owner", "-"), f"{title} ({status})"))
    return out


def cmd_status(hub):
    snap = snapshot()
    agents, last = live(snap), sessions(hub)
    if (hub / "tickets").is_dir():
        open_tasks = [f"{line} @{owner}" for owner, line in open_tickets(hub / "tickets")]
    else:
        tasks = (hub / "TASKS.md").read_text().splitlines() if (hub / "TASKS.md").is_file() else []
        open_tasks = [t.strip() for t in tasks if re.match(r"\s*- \[ \]", t)]
    names = set()
    for row in roster(hub):
        names.add(row["name"])
        a = agents.get(row["name"])
        state = a.get("agent_status", "?") if a else "-"
        pane = a.get("pane_id", "") if a else ""
        sid = (sid_of(a) if a else None) or last.get(row["name"]) or ""
        tab = f" [{row['tab']}]" if row["tab"] else ""
        print(f"{row['name']:<24} {state:<8} {pane:<8} {sid[:8]:<8} {row['folder']} ({row['mode']}){tab}")
        for t in open_tasks:
            if re.search(rf"@{re.escape(row['name'])}\b", t):
                print(f"    {t}")
    others = [t for t in open_tasks if not any(re.search(rf"@{re.escape(n)}\b", t) for n in names)]
    if others:
        print("\nother open tasks:")
        for t in others:
            print(f"    {t}")


def workspace(snap, label, hub):
    ws = next((w for w in snap.get("workspaces", []) if w.get("label") == label), None)
    if ws:
        return ws["workspace_id"]
    created = herdr("workspace", "create", "--cwd", str(hub), "--label", label, "--no-focus").get("result", {})
    if "workspace" not in created:
        die(f"could not create herdr workspace {label!r}")
    return created["workspace"]["workspace_id"]


def cmd_up(hub, names, fresh=False, model=None):
    snap = snapshot()
    if not snap:
        die("herdr is not reachable")
    rows = roster(hub)
    unknown = set(names) - {r["name"] for r in rows}
    if unknown:
        die(f"not in agents.tsv: {' '.join(sorted(unknown))}")
    agents, last = live(snap), sessions(hub)
    ws = workspace(snap, config(hub)["workspace"], hub)
    failed, started_dclaude = [], False
    for row in rows:
        if names and row["name"] not in names:
            continue
        if row["name"] in agents:
            print(f"{row['name']}: running")
            continue
        if not row["dir"].is_dir():
            print(f"{row['name']}: folder {row['dir']} missing", file=sys.stderr)
            failed.append(row["name"])
            continue
        args = ["ha", *(["--host"] if row["mode"] == "host" else []), "--workspace", ws]
        args += [*(["--tab", row["tab"]] if row["tab"] else []), row["name"]]
        if row["extra"] and row["mode"] == "host":
            for d in row["extra"]:
                if not d.is_dir():
                    print(f"{row['name']}: extra dir {d} missing, skipped", file=sys.stderr)
                    continue
                args += ["--add-dir", str(d)]
        elif row["extra"]:
            print(f"{row['name']}: extra dirs ignored, dclaude can't see host paths", file=sys.stderr)
        for plugin in sorted((hub / ".claude" / "plugins").glob("*/.claude-plugin/plugin.json")):
            if row["mode"] == "host":
                args += ["--plugin-dir", str(plugin.parent.parent)]
            else:
                print(f"{row['name']}: plugin {plugin.parent.parent.name} not loaded, dclaude can't see host paths", file=sys.stderr)
        if row["mode"] == "host":
            args += ["--settings", str(write_settings(hub, row))]
        elif (hub / ".claude" / f"settings.{row['name']}.json").is_file():
            print(f"{row['name']}: settings.{row['name']}.json ignored, dclaude can't see host paths", file=sys.stderr)
        if model:
            args += ["--model", model]
        sid = last.get(row["name"])
        if fresh:
            print(f"{row['name']}: starting fresh (--fresh)")
        elif sid and history(row, sid):
            args += ["--resume", sid]
            print(f"{row['name']}: resuming {sid[:8]}")
        else:
            print(f"{row['name']}: starting fresh")
        if subprocess.run(args, cwd=row["dir"], env={**os.environ, "HERDR_ENV": "1"}).returncode != 0:
            print(f"{row['name']}: failed to start", file=sys.stderr)
            failed.append(row["name"])
        elif row["mode"] == "dclaude":
            started_dclaude = True
    cmd_sync(hub, quiet=True)
    # dclaude agents come up in the background, maybe after a container build;
    # keep recording for a while, so a restart doesn't lose their first session.
    if started_dclaude:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "sync", "--watch"], cwd=hub,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    if failed:
        die(f"failed: {' '.join(failed)}")


def cmd_init(label):
    hub = Path.cwd()
    subs = {"{{HUB}}": hub.name, "{{HUB_PATH}}": str(hub), "{{WORKSPACE}}": label or hub.name,
            "{{HUMAN}}": os.environ.get("USER", "human")}
    for src in sorted(TEMPLATES.rglob("*")):
        if src.is_dir():
            continue
        dst = hub / src.relative_to(TEMPLATES)
        if dst.exists():
            print(f"kept    {dst.relative_to(hub)}")
            continue
        text = src.read_text()
        for k, v in subs.items():
            text = text.replace(k, v)
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(text)
        print(f"created {dst.relative_to(hub)}")


def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv else "status"
    rest = argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif cmd == "init":
        cmd_init(rest[0] if rest else None)
    elif cmd == "status":
        cmd_status(find_hub())
    elif cmd == "up":
        cmd_up(find_hub(), rest)
    elif cmd == "restart":
        cmd_restart(find_hub(), rest)
    elif cmd == "settings":
        cmd_settings(find_hub(), rest)
    elif cmd == "sync" and rest == ["--watch"]:
        hub = find_hub()
        for _ in range(40):
            time.sleep(15)
            cmd_sync(hub, quiet=True)
    elif cmd == "sync":
        cmd_sync(find_hub(), quiet=rest == ["-q"])
    else:
        die(f"unknown command {cmd!r} (status, up, restart, settings, sync, init)")


if __name__ == "__main__":
    main()
