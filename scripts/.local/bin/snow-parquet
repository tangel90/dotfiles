#!/home/thomas/.local/share/uv/tools/snowflake-cli/bin/python
"""Run SQL against Snowflake and write the result set as parquet.

Replaces `snow sql --format csv|json` for the "look at it in VisiData" path.

Why not the CLI: `snow sql` only emits *text* (table/csv/json) — it has no
parquet or arrow output format, and installing pyarrow into its venv doesn't
change that. What pyarrow buys is the connector's arrow result format, which
this script uses directly: Snowflake already ships arrow over the wire, so
`fetch_arrow_batches()` hands back the server's own columnar batches. The CLI
path instead deserializes those to Python objects, prints CSV, and then
something downstream re-parses that CSV — two lossy conversions dropped here.

Types survive end to end, so SQL casts finally mean something in VisiData:
TIMESTAMP -> date, FLOAT/INT -> float/int, and no dateutil re-parsing per cell.

The one deliberate exception is DECIMAL. Snowflake returns NUMBER(p,s) — which
is what SUM()/AVG() and most numeric columns come back as — as arrow
decimal128, and VisiData's arrow_to_vdtype has DECIMAL commented out, so those
columns land as anytype holding Decimal objects: not numeric, so no aggregators,
no histogram, no plotting. Casting to float64 here is what makes them usable.
Pass --decimal keep if you need the exact scale (money, invoice totals) more
than you need vd's numeric ops.

Usage:
  snow-parquet -f query.sql [-o out.parquet] [-c connection] [--decimal float|keep]
  snow-parquet -q 'select 1' -o out.parquet
  cat query.sql | snow-parquet -o out.parquet

Prints the output path on stdout (row count and timings go to stderr), so it
composes: vd "$(snow-parquet -f q.sql)"

Interpreter note: the shebang points at the snowflake-cli uv tool venv, which is
where snowflake-connector-python and pyarrow live
(`uv tool install snowflake-cli --with pyarrow`). If uv's tool dir moves, fix
the shebang — a system python3 has neither package.
"""

import argparse
import os
import pathlib
import sys
import time
import tomllib

CONFIG = pathlib.Path.home() / '.snowflake' / 'config.toml'
CONNECTIONS = pathlib.Path.home() / '.snowflake' / 'connections.toml'

# Snowflake CLI accepts private_key_path; the connector only knows
# private_key_file. Connections written for the CLI can carry either.
KEY_ALIASES = {'private_key_path': 'private_key_file'}


def log(msg):
    print(msg, file=sys.stderr)


def connection_params(name=None):
    'Read ~/.snowflake/*.toml the same way the CLI does, and return connect() kwargs.'
    conns = tomllib.loads(CONNECTIONS.read_text()) if CONNECTIONS.exists() else {}
    if not name:
        # Same precedence as the CLI: -c wins, then the env var direnv exports
        # per environment directory, then config.toml. Reading only config.toml
        # sent every run to whatever it names (dev) no matter which env dir the
        # query came from — harmless while queries were env-prefixed by hand,
        # wrong once {{ENV}} makes the directory decide the database.
        name = os.environ.get('SNOWFLAKE_DEFAULT_CONNECTION_NAME', '').strip()
    if not name:
        cfg = tomllib.loads(CONFIG.read_text()) if CONFIG.exists() else {}
        name = cfg.get('default_connection_name', 'default')
    # connections.toml sections are lower-case; the env var is often set to TST/DEV
    if name not in conns and name.lower() in conns:
        name = name.lower()
    if name not in conns:
        sys.exit(f'snow-parquet: unknown connection {name!r}; have {sorted(conns)}')
    return name, {KEY_ALIASES.get(k, k): v for k, v in conns[name].items()}


def dedupe_names(names):
    """Make column names unique, appending _2, _3 … to later repeats.

    `select *` over a join happily returns the same column twice (FACT_RISK
    yielded REPORTING_COUNTERPARTY_ID and PORTFOLIO_GROUP_ID twice), and a
    parquet file with duplicate field names is unreadable: pyarrow's read_table
    fails outright with "Can't unify schema with duplicate field names", so
    VisiData, pandas and duckdb all bounce off it. Better to rename here than to
    write a file nothing can open.
    """
    seen = {}
    out = []
    for name in names:
        if name in seen:
            seen[name] += 1
            out.append(f'{name}_{seen[name]}')
        else:
            seen[name] = 1
            out.append(name)
    return out


def float_schema(schema, pa):
    'Same schema with decimal columns widened to float64; None if nothing to change.'
    fields = []
    changed = False
    for f in schema:
        if pa.types.is_decimal(f.type):
            fields.append(f.with_type(pa.float64()))
            changed = True
        else:
            fields.append(f)
    return pa.schema(fields) if changed else None


def write_parquet(batches, out, decimal_mode, pa, pq):
    '''Stream arrow data to a parquet file. Returns (rows, columns).

    Despite the name, snowflake-connector's fetch_arrow_batches() yields
    pyarrow *Tables* (its signature says Iterator[Table]), so wrapping each
    item in Table.from_batches() raised "Cannot convert pyarrow.lib.Table to
    pyarrow.lib.RecordBatch". Accept either shape: a Table goes straight
    through, a RecordBatch gets wrapped.
    '''
    writer = None
    schema = None
    rows = 0
    try:
        names = None
        for batch in batches:
            tbl = batch if isinstance(batch, pa.Table) else pa.Table.from_batches([batch])
            if names is None:
                names = dedupe_names(tbl.schema.names)
                renamed = [(a, b) for a, b in zip(tbl.schema.names, names) if a != b]
                if renamed:
                    log('snow-parquet: duplicate column(s) renamed: '
                        + ', '.join(f'{a} -> {b}' for a, b in renamed))
            if names != tbl.schema.names:
                tbl = tbl.rename_columns(names)
            if writer is None:
                schema = tbl.schema
                if decimal_mode == 'float':
                    schema = float_schema(schema, pa) or schema
                writer = pq.ParquetWriter(out, schema)
            writer.write_table(tbl.cast(schema))
            rows += tbl.num_rows
    finally:
        if writer is not None:
            writer.close()
    return rows, schema


def pick_cursor(cursors):
    """The statement whose result set is worth writing.

    Snowflake only returns Arrow for real query results; USE / SET / DDL / SHOW
    come back as JSON, and their cursors still carry a description (a `status`
    column), so "last cursor with a description" happily picked one of those and
    fetch_arrow_batches() then raised NotSupportedError. Prefer the last Arrow
    result, and fall back to the last cursor that returned anything at all.
    """
    arrow = [c for c in cursors if c.description and getattr(c, '_query_result_format', None) == 'arrow']
    if arrow:
        return arrow[-1], True
    described = [c for c in cursors if c.description]
    if described:
        return described[-1], False
    return cursors[-1], False


def write_rows(cursor, out, pa, pq):
    """Write a non-Arrow (JSON) result set: SHOW/DESCRIBE output, DDL status …

    Types come from whatever the connector already parsed, so pyarrow infers
    them; that is good enough for the metadata-shaped results that land here.
    """
    names = dedupe_names([d[0] if isinstance(d, (list, tuple)) else d.name for d in (cursor.description or [])])
    rows = cursor.fetchall()

    data = {}
    for i, name in enumerate(names):
        values = [r[i] for r in rows]
        try:
            data[name] = pa.array(values)
        except pa.ArrowInvalid:
            # Mixed types in one column (SHOW output does this); strings always work.
            data[name] = pa.array([None if v is None else str(v) for v in values])

    pq.write_table(pa.table(data), out)
    return len(rows), names


def empty_parquet(cursor, out, pa, pq):
    '''No batches at all: still produce a readable file rather than nothing.

    A 0-row result yields no arrow batches, so there is no arrow schema to
    reuse; fall back to the cursor description for column names. Types are
    unknowable from an empty result, and an empty column is untyped in
    VisiData anyway.
    '''
    names = [d.name for d in (cursor.description or [])]
    tbl = pa.table({n: pa.array([], pa.string()) for n in names})
    pq.write_table(tbl, out)
    return names


ENV_PLACEHOLDER = '{{ENV}}'


def expand_env(sql):
    """Substitute {{ENV}} with $ENV, so one query tree serves dev/tst/prd.

    The database prefix is the only thing that differs between environments
    (TST_RV vs DEV_RV), which otherwise forces a copy of every query per env.
    Queries under ~/data/snowflake/database_explorer write {{ENV}}_RV.CORE.X
    and direnv supplies ENV per directory.

    Failing loudly matters: an empty substitution would silently query
    `_RV.CORE.X`, and a wrong one would hit the wrong environment.
    """
    if ENV_PLACEHOLDER not in sql:
        return sql
    env = os.environ.get('ENV', '').strip()
    if not env:
        sys.exit(f'snow-parquet: SQL contains {ENV_PLACEHOLDER} but $ENV is unset (direnv not allowed in this directory?)')
    log(f'snow-parquet: {ENV_PLACEHOLDER} -> {env.upper()}')
    return sql.replace(ENV_PLACEHOLDER, env.upper())


def main():
    ap = argparse.ArgumentParser(add_help=True, description='run SQL on Snowflake, write parquet')
    src = ap.add_mutually_exclusive_group()
    src.add_argument('-f', '--file', help='.sql file to run (default: read stdin)')
    src.add_argument('-q', '--query', help='SQL to run')
    ap.add_argument('-o', '--out', help='output .parquet (default: alongside -f, or ./query.parquet)')
    ap.add_argument('-c', '--connection', help='connection name (default: config.toml default_connection_name)')
    ap.add_argument(
        '--decimal',
        choices=['float', 'keep'],
        default='float',
        help='DECIMAL/NUMBER columns: cast to float64 so VisiData treats them as numeric (default), or keep exact',
    )
    args = ap.parse_args()

    if args.query:
        sql = args.query
    elif args.file:
        sql = pathlib.Path(args.file).read_text()
    else:
        sql = sys.stdin.read()
    if not sql.strip():
        sys.exit('snow-parquet: no SQL given')

    sql = expand_env(sql)

    if args.out:
        out = args.out
    elif args.file:
        out = str(pathlib.Path(args.file).with_suffix('.parquet'))
    else:
        out = 'query.parquet'

    import pyarrow as pa
    import pyarrow.parquet as pq
    import snowflake.connector

    name, params = connection_params(args.connection)
    log(f'snow-parquet: connection {name}')

    t0 = time.perf_counter()
    conn = snowflake.connector.connect(**params)
    t_conn = time.perf_counter() - t0
    try:
        # execute_string handles multi-statement files; the last statement that
        # returned a result set is the one worth writing (mirrors how `snow sql`
        # shows the final SELECT after USE/SET preamble statements).
        t0 = time.perf_counter()
        cursors = conn.execute_string(sql)
        if not cursors:
            sys.exit('snow-parquet: no statements executed')
        cursor, is_arrow = pick_cursor(cursors)
        t_exec = time.perf_counter() - t0

        t0 = time.perf_counter()
        if is_arrow:
            rows, schema = write_parquet(cursor.fetch_arrow_batches(), out, args.decimal, pa, pq)
            if schema is None:
                cols = empty_parquet(cursor, out, pa, pq)
                log(f'snow-parquet: 0 rows, columns {cols}')
        else:
            # No Arrow result in the script: the last statement was DDL, USE,
            # SHOW or similar. Write what it did return rather than failing.
            rows, cols = write_rows(cursor, out, pa, pq)
            log(f'snow-parquet: non-query result ({", ".join(cols) or "no columns"}); wrote it as-is')
        t_fetch = time.perf_counter() - t0
    finally:
        conn.close()

    size = os.path.getsize(out)
    log(f'snow-parquet: {rows} rows, {size / 1e6:.1f} MB  (connect {t_conn:.1f}s, execute {t_exec:.1f}s, fetch+write {t_fetch:.1f}s)')
    print(out)


if __name__ == '__main__':
    main()
