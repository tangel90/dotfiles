#!/usr/bin/env bash
# prefix+E: pick a directory, then open yazi there in a new window.
#
# Candidates come from zoxide, ranked by frecency — the same set yazi offers
# under `cd --interactive`, so the two agree on what "my directories" means.
# Any arguments are passed to zoxide as query keywords, so `prefix+E dev` (or
# calling this by hand) narrows the list before fzf ever draws.
#
# Previously this walked the filesystem with fd to depth 6 from $HOME. That
# listed thousands of directories most of which had never been visited, and
# ordered them by path depth rather than by how often they are actually used.
# fd is kept only as a fallback for machines without zoxide.
#
# Meant to be run from `display-popup -E`, so the picker draws in the popup and
# the popup closes as soon as this exits.
set -uo pipefail

# Directory contents make a far more useful preview than the path alone.
if command -v eza >/dev/null 2>&1; then
    preview='eza -a --icons --color=always {}'
elif command -v exa >/dev/null 2>&1; then
    preview='exa -a --icons --color=always {}'
else
    preview='ls -A --color=always {}'
fi

if command -v zoxide >/dev/null 2>&1; then
    # --tiebreak=index keeps zoxide's frecency order when fzf scores are equal.
    # The `-d` filter drops entries whose directory has since been deleted;
    # zoxide keeps those in its database until it next prunes.
    selected=$(
        zoxide query -l -- "$@" 2>/dev/null |
            while IFS= read -r dir; do [[ -d $dir ]] && printf '%s\n' "$dir"; done |
            fzf --tiebreak=index --preview "$preview" --preview-window 'right,50%,border-left'
    )
else
    search_roots=("$HOME")
    depth=6
    if [[ $# -ge 1 ]]; then
        search_roots=("$@")
        depth=4
    fi
    # awk/sort/cut: order by path depth then alphabetically, so shallow (usually
    # more interesting) directories come first — same trick as tmux-sessionizer.
    selected=$(fd . "${search_roots[@]}" --type d -d "$depth" --hidden --follow \
        -E "notes/" -E "tmp/" -E ".password-store" -E "queries/" |
        awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- |
        fzf --tiebreak=length,index --preview "$preview")
fi

[[ -z ${selected:-} ]] && exit 0

# Window name from the directory, dots swapped for underscores: tmux treats a
# leading dot fine but dots read badly in the status line.
window_name=$(basename "$selected" | tr . _)

tmux new-window -n "${window_name:-yazi}" -c "$selected" yazi
