#!/usr/bin/env python3
"""agents-gen: write every harness's agent definitions from one source.

    agents-gen            write them
    agents-gen --check    exit 1 and name the files that differ (nothing written)

Sources, in this repo's tools/agents/.agents/ (stowed to ~/.agents/):
    roles/ROLE.md         the role, harness-neutral; header: name, description
    harness/HARNESS.md    passages per harness, each after <!-- snippet: NAME -->
    teams.toml            per team (harness): model per role, and its words

A role's text may use
    {{> NAME}}                         that harness's snippet NAME
    {{team}} {{clear}} {{lead_start}}  the team's name, fresh-conversation
                                       command, how its lead is started
    {{label:ROLE}}                     the model name of ROLE on this team
    <!-- if claude pi --> ... <!-- endif -->   lines for those harnesses only

Output, committed and stowed like any other file, one per role the team
lists (files carrying the generated notice that no team lists any more are
removed):
    claude    tools/claude/.claude/agents/ROLE.md         (model, tools)
    opencode  tools/opencode/.config/opencode/agents/ROLE.md  (mode, model)
    pi        tools/pi/.pi/agent/roles/ROLE.md             (model, thinking)
A further team of a harness is a table named HARNESS-ID; its files go to
TEAMS[HARNESS]/ID/ROLE.md (OpenCode only: tools/opencode/.config/opencode/
teams/ID/, which hoc --team ID links into a repo's .opencode/agents).
Generated files are read-only, so an edit there fails instead of being lost
at the next run: edit the sources instead.
"""

import re
import sys
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parents[3]
SRC = REPO / "tools/agents/.agents"
OUT = {
    "claude": REPO / "tools/claude/.claude/agents",
    "opencode": REPO / "tools/opencode/.config/opencode/agents",
    "pi": REPO / "tools/pi/.pi/agent/roles",
}
TEAMS = {"opencode": REPO / "tools/opencode/.config/opencode/teams"}
HEADER_KEYS = {"claude": ["model", "tools"], "opencode": ["model"], "pi": ["model", "thinking"]}
NOTICE = ("<!-- Generated by agents-gen from ~/.agents/roles/{role}.md, ~/.agents/harness/{h}.md and "
          "~/.agents/teams.toml (dotfiles tools/agents). Edit those, then run agents-gen; "
          "this file is overwritten. -->")


def die(msg):
    sys.exit(f"agents-gen: {msg}")


def snippets(harness):
    text = (SRC / "harness" / f"{harness}.md").read_text()
    parts = re.split(r"^<!-- snippet: ([a-z-]+) -->$", text, flags=re.M)
    return {parts[i]: parts[i + 1].strip("\n") for i in range(1, len(parts), 2)}


def split_role(path):
    text = path.read_text()
    if not text.startswith("---\n"):
        die(f"{path} has no header")
    head, body = text[4:].split("\n---\n", 1)
    meta = {}
    for line in head.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip()
    return meta, body


def render(text, harness, team, snips, where):
    out, keep = [], True
    for line in text.split("\n"):
        m = re.fullmatch(r"<!-- if ([a-z ]+) -->", line.strip())
        if m:
            keep = harness in m.group(1).split()
            continue
        if line.strip() == "<!-- endif -->":
            keep = True
            continue
        if keep:
            out.append(line)
    text = "\n".join(out)

    def include(m):
        name = m.group(1)
        if name not in snips:
            die(f"{where}: harness/{harness}.md has no snippet {name}")
        return snips[name]

    text = re.sub(r"\{\{> ([a-z-]+)\}\}", include, text)

    def var(m):
        key = m.group(1)
        if key.startswith("label:"):
            role = key[6:]
            label = team.get("roles", {}).get(role, {}).get("label")
            if not label:
                die(f"{where}: teams.toml has no {harness}.roles.{role}.label")
            return label
        if key == "team":
            key = "name"
        if key not in team or not isinstance(team[key], str):
            die(f"{where}: teams.toml has no {harness}.{key}")
        return team[key]

    text = re.sub(r"\{\{([a-z_]+(?::[a-z-]+)?)\}\}", var, text)
    return re.sub(r"\n{3,}", "\n\n", text).strip("\n") + "\n"


def team_tables(teams):
    """(harness, team, outdir) for every team: each harness's default team,
    then the HARNESS-ID tables."""
    out = []
    for harness, outdir in OUT.items():
        out.append((harness, teams.get(harness) or die(f"teams.toml has no [{harness}]"), outdir))
    for key, team in teams.items():
        if key in OUT:
            continue
        harness, _, tid = key.partition("-")
        if harness not in TEAMS or not re.fullmatch(r"[a-z0-9]+", tid):
            die(f"teams.toml: [{key}] is no harness and no <harness>-<id> team "
                f"(further teams work for: {', '.join(TEAMS)})")
        out.append((harness, team, TEAMS[harness] / tid))
    return out


def build():
    teams = tomllib.loads((SRC / "teams.toml").read_text())
    files = {}
    for harness, team, outdir in team_tables(teams):
        snips = snippets(harness)
        for role, cfg in team.get("roles", {}).items():
            path = SRC / "roles" / f"{role}.md"
            if not path.is_file():
                die(f"teams.toml lists {harness}.roles.{role}, but {path} is missing")
            meta, body = split_role(path)
            where = f"roles/{role}.md for {harness}"
            desc = render(meta.get("description", ""), harness, team, snips, where).strip()
            head = [f"name: {role}"] if harness == "claude" else []
            head.append(f"description: {desc}")
            if harness == "opencode":
                head.append("mode: primary")
            head += [f"{k}: {cfg[k]}" for k in HEADER_KEYS[harness] if k in cfg]
            text = ("---\n" + "\n".join(head) + "\n---\n\n" + NOTICE.format(role=role, h=harness)
                    + "\n\n" + render(body, harness, team, snips, where))
            files[outdir / f"{role}.md"] = text
    return files


def stale(files):
    """Generated files no team lists any more."""
    out = []
    dirs = list(OUT.values()) + [d for t in TEAMS.values() if t.is_dir() for d in t.iterdir() if d.is_dir()]
    for outdir in dirs:
        for f in outdir.glob("*.md"):
            if f not in files and "Generated by agents-gen" in f.read_text():
                out.append(f)
    return out


def main():
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] and not check:
        sys.exit(__doc__.split("\n\n")[1])
    files = build()
    differ = [f for f, t in files.items() if not f.is_file() or f.read_text() != t] + stale(files)
    if check:
        for f in differ:
            print(f"agents-gen: out of date: {f.relative_to(REPO)}")
        sys.exit(1 if differ else 0)
    for f, t in files.items():
        if f.is_file() and f.read_text() == t:
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        if f.exists():
            f.chmod(0o644)
        f.write_text(t)
        f.chmod(0o444)
        print(f"agents-gen: wrote {f.relative_to(REPO)}")
    for f in stale(files):
        f.chmod(0o644)
        f.unlink()
        print(f"agents-gen: removed {f.relative_to(REPO)}")
    for f in files:
        f.chmod(0o444)


if __name__ == "__main__":
    main()
