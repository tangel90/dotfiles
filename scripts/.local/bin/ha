#!/usr/bin/env bash
# ha [--host] NAME [claude args...]: start claude as a named herdr agent in a
# new tab (labelled NAME) of the shared "agents" workspace, created on first
# use, so `herdr agent prompt NAME ...` reaches it from anywhere. It runs in the
# project's devcontainer through dclaude (always a fresh session, --new), or
# with --host as plain claude on the host.
#
# A new tab rather than this pane: agent start needs its pane idle at a shell
# prompt, and this one is busy running ha. A tab rather than a split, so the
# agent gets the full window. A separate workspace, so agents stay out of the
# project's tab bar; reach them through the agents panel or prefix+alt+1..9.
# The fresh shell takes a moment to reach its prompt, hence the retries.
#
# herdr agent start only launches the canonical claude executable, so dclaude
# is typed into the tab instead, and the agent named once herdr detects it —
# in the background, since the first dclaude in a project may build its
# container for minutes.

set -euo pipefail

[ "${HERDR_ENV:-}" = 1 ] || { echo "ha: not inside a herdr pane" >&2; exit 1; }
host=
if [ "${1:-}" = --host ]; then
    host=1
    shift
fi
(( $# )) || { echo "usage: ha [--host] NAME [claude args...]" >&2; exit 2; }

name=$1
shift

ws=$(herdr workspace list | jq -r '.result.workspaces[] | select(.label == "agents") | .workspace_id' | head -n1)
if [ -n "$ws" ]; then
    pane=$(herdr tab create --workspace "$ws" --cwd "$PWD" --label "$name" --focus | jq -r .result.root_pane.pane_id)
else
    # A new workspace comes with a tab of its own; use that one.
    created=$(herdr workspace create --label agents --cwd "$PWD" --focus)
    pane=$(jq -r .result.root_pane.pane_id <<<"$created")
    herdr tab rename "$(jq -r .result.tab.tab_id <<<"$created")" "$name" >/dev/null
fi

if [ -z "$host" ]; then
    herdr pane run "$pane" "$(printf '%q ' dclaude --new "$@")" >/dev/null
    (
        for _ in {1..600}; do
            if herdr agent list | jq -e --arg p "$pane" 'any(.result.agents[]; .pane_id == $p)' >/dev/null; then
                herdr agent rename "$pane" "$name" >/dev/null
                exit 0
            fi
            sleep 1
        done
    ) </dev/null >/dev/null 2>&1 &
    disown
    exit 0
fi

(( $# )) && set -- -- "$@"
for _ in {1..20}; do
    out=$(herdr agent start "$name" --kind claude --pane "$pane" "$@" 2>&1) && exit 0
    sleep 0.5
done
echo "ha: $out" >&2
exit 1
