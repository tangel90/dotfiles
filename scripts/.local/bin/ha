#!/usr/bin/env bash
# ha [--host] [--workspace ID] [--tab LABEL] NAME [claude args...]: start claude
# as a named herdr agent in a new tab (labelled NAME) of this workspace, or of
# ID, so `herdr agent prompt NAME ...` reaches it from anywhere. With --tab, it
# joins the tab labelled LABEL as a new split instead, creating that tab if
# there is none, to group agents (e.g. rds's dbt-workers). It runs in the
# project's devcontainer through dclaude (always a fresh session, --new), or
# with --host as plain claude on the host.
#
# A new tab rather than this pane: agent start needs its pane idle at a shell
# prompt, and this one is busy running ha. A tab rather than a split, so the
# agent gets the full window. The fresh shell takes a moment to reach its
# prompt, hence the retries.
#
# herdr agent start only launches the canonical claude executable, so dclaude
# is typed into the tab instead, and the agent named once herdr detects it —
# in the background, since the first dclaude in a project may build its
# container for minutes.

set -euo pipefail

[ "${HERDR_ENV:-}" = 1 ] || { echo "ha: not inside a herdr pane" >&2; exit 1; }
host=
ws=
group=
while [ $# -gt 0 ]; do
    case $1 in
        --host) host=1 ;;
        --workspace) ws=${2:?ha: --workspace needs an ID}; shift ;;
        --tab) group=${2:?ha: --tab needs a LABEL}; shift ;;
        *) break ;;
    esac
    shift
done
(( $# )) || { echo "usage: ha [--host] [--workspace ID] [--tab LABEL] NAME [claude args...]" >&2; exit 2; }

# herdr's rule for agent names; lowercased here, and checked before a tab is
# made for it, so a bad name doesn't leave an empty tab behind.
name=${1,,}
shift
[[ $name =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || { echo "ha: agent name must start with a letter and contain only letters, digits, '-' or '_' (1-32 characters)" >&2; exit 2; }

# The caller's workspace, not whichever one the UI has focused. Asked via the
# pane: HERDR_WORKSPACE_ID goes stale once the pane moves to another workspace.
# --workspace is for callers without a pane of their own, like hp's popup.
[ -n "$ws" ] || ws=$(herdr pane get "$HERDR_PANE_ID" | jq -r .result.pane.workspace_id)
tab=
[ -z "$group" ] || tab=$(herdr tab list --workspace "$ws" | jq -r --arg l "$group" 'first(.result.tabs[] | select(.label == $l) | .tab_id) // empty')
if [ -n "$tab" ]; then
    # Split the largest pane (ties within 10%: the right-most, then lowest),
    # right if it's at least as wide as tall, else down. A terminal cell is
    # about twice as tall as wide, hence 2*height. 1 = A, 2 = A|B, 3 = A|B/C, 4 = A/D|B/C
    # (2x2), and so on. Rects come from pane layout; the jq accepts them flat
    # or under .rect.
    panes=$(herdr pane list --workspace "$ws" | jq -c --arg t "$tab" '[.result.panes[] | select(.tab_id == $t) | .pane_id]')
    first=$(jq -r 'first // empty' <<<"$panes")
    [ -n "$first" ] || { echo "ha: tab $group has no panes" >&2; exit 1; }
    read -r target dir < <(herdr pane layout --pane "$first" | jq -r --argjson ids "$panes" '
        [.. | objects | select(.pane_id? as $p | $ids | index($p))
            | (.rect // .) as $r | select($r.width and $r.height)
            | {id: .pane_id, x: ($r.x // 0), y: ($r.y // 0), w: $r.width, h: $r.height, a: ($r.width * $r.height)}]
        | unique_by(.id)
        | (map(.a) | max) as $m
        | map(select(.a >= 0.9 * $m)) | max_by([.x, .y])
        | "\(.id) \(if .w >= 2 * .h then "right" else "down" end)"')
    # No usable layout: fall back to the tab's last pane, split right.
    [ -n "${target:-}" ] || { target=$(jq -r last <<<"$panes"); dir=right; }
    pane=$(herdr pane split "$target" --direction "$dir" --cwd "$PWD" | jq -r .result.pane.pane_id)
else
    pane=$(herdr tab create --workspace "$ws" --cwd "$PWD" --label "${group:-$name}" --focus | jq -r .result.root_pane.pane_id)
fi
# Pane label too: herdr's sidebar has no token for the agent name, so the
# agent rows show the pane label instead (config.toml). Unlike the tab label
# it follows the pane when hbreak or a move takes it elsewhere.
herdr pane rename "$pane" "$name" >/dev/null

if [ -z "$host" ]; then
    herdr pane run "$pane" "$(printf '%q ' dclaude --new "$@")" >/dev/null
    (
        for _ in {1..600}; do
            if herdr agent list | jq -e --arg p "$pane" 'any(.result.agents[]; .pane_id == $p)' >/dev/null; then
                herdr agent rename "$pane" "$name" >/dev/null
                exit 0
            fi
            sleep 1
        done
    ) </dev/null >/dev/null 2>&1 &
    disown
    exit 0
fi

(( $# )) && set -- -- "$@"
for _ in {1..20}; do
    out=$(herdr agent start "$name" --kind claude --pane "$pane" "$@" 2>&1) && exit 0
    # An attempt can start and name the agent yet still exit non-zero; the
    # retry then hits agent_name_taken on our own pane.
    if [[ $out == *agent_name_taken* ]] &&
        herdr agent list | jq -e --arg p "$pane" --arg n "$name" 'any(.result.agents[]; .pane_id == $p and .name == $n)' >/dev/null; then
        exit 0
    fi
    sleep 0.5
done
echo "ha: $out" >&2
exit 1
