#!/usr/bin/env bash
# ha NAME [claude args...]: start claude as a named herdr agent in a new tab
# (labelled NAME) of this workspace, so `herdr agent prompt NAME ...` reaches
# it from anywhere.
#
# A new tab rather than this pane: agent start needs its pane idle at a shell
# prompt, and this one is busy running ha. A tab rather than a split, so the
# agent gets the full window. The fresh shell takes a moment to reach its
# prompt, hence the retries.

set -euo pipefail

[ "${HERDR_ENV:-}" = 1 ] || { echo "ha: not inside a herdr pane" >&2; exit 1; }
(( $# )) || { echo "usage: ha NAME [claude args...]" >&2; exit 2; }

name=$1
shift
(( $# )) && set -- -- "$@"

# The caller's workspace, not whichever one the UI has focused.
pane=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$PWD" --label "$name" --focus | jq -r .result.root_pane.pane_id)
for _ in {1..20}; do
    out=$(herdr agent start "$name" --kind claude --pane "$pane" "$@" 2>&1) && exit 0
    sleep 0.5
done
echo "ha: $out" >&2
exit 1
