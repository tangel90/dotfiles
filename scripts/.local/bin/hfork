#!/usr/bin/env bash
# hfork [NAME]: fork the Claude conversation in this herdr pane into a new
# tab (via ha --host, since this is a host session). Run it from inside Claude
# as `!hfork`. NAME defaults to this agent's name plus -fork (-fork2, ... when
# taken).
#
# Claude's own /fork starts the fork as a background session with no pane, so
# herdr doesn't see it until attached — and an attached pane records the
# viewer's session id, not the fork's, so herdr can't resume it after a
# restart. `claude --resume <id> --fork-session` in a pane is a normal
# foreground session instead: herdr tracks it under its real id, by name.
#
# The conversation id comes from herdr, which recorded it for this pane when
# the session started.

set -euo pipefail

[ "${HERDR_ENV:-}" = 1 ] || { echo "hfork: not inside a herdr pane" >&2; exit 1; }
if [ "${DCLAUDE:-}" = 1 ]; then
    # The new tab would open on the host, where the container's conversations
    # (and its /workspaces path) don't exist.
    echo "hfork: inside dclaude — fork with: dclaude --resume <id> --fork-session" >&2
    exit 1
fi

# HERDR_PANE_ID goes stale when the pane moves to another workspace; herdr
# still resolves it, and reports the current id.
info=$(herdr pane get "$HERDR_PANE_ID")
pane=$(jq -r .result.pane.pane_id <<<"$info")
sid=$(jq -r '.result.pane.agent_session.value // empty' <<<"$info")
[ -n "$sid" ] || { echo "hfork: herdr has no claude session recorded for this pane" >&2; exit 1; }

name=${1:-}
if [ -z "$name" ]; then
    agents=$(herdr agent list)
    base=$(jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .name // empty' <<<"$agents")
    base=${base:+$base-fork}
    base=${base:-fork-${sid:0:8}}
    name=$base
    n=1
    while jq -e --arg n "$name" '.result.agents[] | select(.name == $n)' <<<"$agents" >/dev/null; do
        name=$base$((++n))
    done
fi

exec ha --host "$name" --resume "$sid" --fork-session
