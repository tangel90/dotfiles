# Carried over from the old config.ghostty, which Ghostty never read.
confirm-close-surface = false

font-size = 16

# Startup window size, in character cells (not pixels).
# 136x44 at font-size 16 matches the current workspace-1 window.
window-width = 136
window-height = 44

# Always open at the size above instead of restoring the last window's size.
window-save-state = never

# No title bar; KDE still draws the border. Move/resize with Meta+drag.
gtk-titlebar = false
