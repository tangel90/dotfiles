// Fallback devcontainer for projects without their own .devcontainer/ —
// picked up by `dclaude`. Keep it generic; project-specific toolchains belong
// in that project's own devcontainer.json.
{
  "name": "default",
  // Debian-family with git/curl/zsh and a uid-1000 "vscode" user. glibc
  // matters: dclaude falls back to the host claude binary, which won't run on
  // alpine.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  // Remap vscode to the host uid, so bind-mounted files stay yours and the
  // 0600 herdr socket is reachable.
  "updateRemoteUserUID": true,
  // Docker's default seccomp profile plus user namespaces, which bubblewrap
  // (Claude Code's Bash sandbox, turned on by dclaude) needs. Docker resolves
  // the path on the host, hence the stowed copy under ~/.config.
  "runArgs": ["--security-opt=seccomp=${localEnv:HOME}/.config/devcontainer/default/seccomp-userns.json"],
  "features": {
    // The herdr SessionStart hook is a python3 script. os-provided = apt
    // package, no build from source.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    }
  },
  // The host statusline script parses claude's JSON with jq; Claude's sandbox
  // needs bubblewrap and socat. pre-commit and detect-secrets for repos with
  // hooks, installed to /usr/local/bin: on PATH in every shell, sandbox
  // included, and the fallback of host-installed .git/hooks/pre-commit.
  "postCreateCommand": "(command -v jq && command -v bwrap && command -v socat && command -v pipx) >/dev/null || (sudo apt-get update && sudo apt-get install -y jq bubblewrap socat pipx); for t in pre-commit detect-secrets; do command -v $t >/dev/null || sudo PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install $t; done"
}
