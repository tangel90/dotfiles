import datetime
import os
import tempfile

from visidata import BaseSheet, VisiData, vd

### options
vd.options.csv_doublequote = True

### Route yank/paste through the portable clipboard helpers. VisiData detects
### WSL from the kernel release and hardcodes `clip.exe` for copy and
### `powershell.exe -command Get-Clipboard` for paste (clipboard.py); both go
### through the Windows console codepage, so a yanked "Tarifvertraege" arrived as
### "Tarifvertr" + CP850 garbage — UTF-8 bytes C3 A4 read as two OEM glyphs. The
### helpers use win32yank on WSL and wl-copy/xclip/xsel/pbcopy elsewhere, so this
### stays correct on the native Linux machines that share these dotfiles.
vd.options.clipboard_copy_cmd = "clipboard-copy"
vd.options.clipboard_paste_cmd = "clipboard-paste"

### Write a UTF-8 BOM when saving. VisiData's defaults are asymmetric — it reads
### as utf-8-sig (path.py) but writes plain utf-8 (save.py) — and Excel, opened
### by double-clicking a .csv, does not sniff UTF-8: it assumes the Windows ANSI
### codepage (cp1252 here), so "Wärme" arrived as "WÃ¤rme". The BOM is the signal
### Excel looks for, and it's what Excel itself emits under "CSV UTF-8".
### Costless on the read side, since utf-8-sig strips the BOM again.
### Caveat: consumers reading with plain utf-8 see ﻿ glued to the first
### header name (duckdb and pandas both handle it; naive split() parsers don't).
vd.options.save_encoding = "utf-8-sig"

vd.option(
    "save_dir",
    "/home/thomas/data/visidata",
    "directory (dated subfolder appended) suggested when saving a sheet",
    sheettype=None,
)

### Default save location: sheets opened from scratch/tmp files (e.g. yazi/nvim
### previews, or the sql runners' query results, all under ~/.local/tmp)
### otherwise default their save prompt to that same tmp path — easy to silently
### overwrite the tmp file instead of keeping the result. Keep the suggested
### basename but default its directory to options.save_dir/<today's date>,
### creating that dated folder if needed (VisiData itself only auto-creates a
### directory when the save path ends in '/', i.e. the "save each row as its own
### file" case — not here).
###
### A file opened from a real location is left alone: ^S then offers its own path
### back, so saving over it works like stock VisiData instead of quietly forking
### a copy into the data dir. Only tmp paths and sheets with no file source at
### all (freq tables, joins, transposes, +-derived sheets) get redirected.
_TMPDIRS = (
    os.path.realpath(os.path.expanduser("~/.local/tmp")),
    os.path.realpath(tempfile.gettempdir()),
    "/tmp",
    "/dev/shm",
)


def _under_tmp(path):
    rp = os.path.realpath(path)
    return any(rp == d or rp.startswith(d + os.sep) for d in _TMPDIRS)


_orig_getDefaultSaveName = BaseSheet.getDefaultSaveName


@BaseSheet.api
def getDefaultSaveName(sheet):
    name = _orig_getDefaultSaveName(sheet)
    savedir = sheet.options.save_dir
    if not savedir:
        return name
    # An absolute path that exists and isn't scratch: it's a real file the sheet
    # was loaded from, so keep it. getDefaultSaveName returns str(source) in that
    # case, and only a bare 'name.filetype' for source-less sheets.
    if os.path.isabs(name) and os.path.exists(name) and not _under_tmp(name):
        return name
    datedir = os.path.join(savedir, datetime.date.today().isoformat())
    os.makedirs(datedir, exist_ok=True)
    return os.path.join(datedir, os.path.basename(name))


### Path prompts (save-sheet ^S, save-all g^S, save-selected, open-file, …) all
### funnel through inputFilename, which defaults its cursor to position 0. With
### a prefilled value (e.g. the save_dir path above) that means every motion
### key is fighting a cursor sitting in front of the text instead of after it,
### and — because VisiData treats "cursor at 0" as license to wipe the whole
### field on the very first keystroke — there's no way to just edit the
### filename in place. Defaulting the cursor to the end fixes both: normal
### editing (^B/^F/^W/^A/^E/Backspace) works immediately, and a full manual
### retype is one extra keystroke away via ^U (clear to start-of-line, which
### from the end clears everything).
###
### For actual vim motions on any input field (not just save prompts): ^O
### dumps the field to a tempfile, opens $EDITOR (nvim) on it, and feeds the
### saved result back in — no config needed, it's a built-in VisiData keybinding.
_orig_inputFilename = VisiData.inputFilename


@VisiData.api
def inputFilename(vd, prompt, *args, **kwargs):
    value = kwargs.get("value", "")
    if value and "i" not in kwargs:
        kwargs["i"] = len(str(value))
    return _orig_inputFilename(vd, prompt, *args, **kwargs)


### System-clipboard yank (Y / gY / gzY) prompts "copy N rows as filetype:"
### defaulted to 'tsv'. Default it to 'csv' instead, still editable inline.
### Scoped to just this prompt rather than options.save_filetype, since that
### option is also read by getDefaultSaveName above (^S's suggested
### extension) and changing it globally would affect that too.
_orig_syscopyCells = Sheet.syscopyCells


@Sheet.api
def syscopyCells(sheet, cols, rows, filetype=None):
    if filetype is None:
        filetype = vd.input(
            "copy %d %s as filetype: " % (len(rows), sheet.rowtype), value="csv"
        )
    sheet.syscopyCells_async(cols, rows, filetype)


### Saving parquet (^S foo.parquet) silently threw away the time of day: a date
### column holding 2024-12-31T23:00 came back as 2024-12-31T00:00 on reopen.
### VisiData's save_parquet hardcodes `date: pa.date64()` in its type map
### (loaders/parquet.py), and pyarrow normalises that to date32[day] — a
### calendar date with no time component at all. Anything sub-daily is lost at
### write time, so no amount of retyping the column afterwards recovers it.
###
### Rather than copy upstream's whole writer here (it would silently drift on
### the next VisiData release), swap out what pa.date64 returns for just the
### duration of the save, so the same code path builds a timestamp column
### instead. Date-only columns are unaffected in practice — they simply write as
### timestamps at midnight, and reload as dates with a zero time.
###
### Caveat: the patch is process-global while the save runs, so two parquet
### saves racing in different threads could see it. Saves are one-at-a-time in
### practice, and the window is a single write.
_orig_save_parquet = VisiData.save_parquet


@VisiData.api
def save_parquet(vd, p, sheet):
    pa = vd.importExternal("pyarrow")
    orig_date64 = pa.date64
    pa.date64 = lambda: pa.timestamp("us")
    try:
        return _orig_save_parquet(vd, p, sheet)
    finally:
        pa.date64 = orig_date64


@vd.numericType("%")
def floatde(s=None):
    "German decimal comma: 1.234,56 -> 1234.56"
    if s is None:
        return 0.0
    return float(str(s).strip().replace(".", "").replace(",", "."))


### Make parquet sheets editable. Edits (e), g= / setcol-expr, fill, negate —
### anything going through Column.setValue — reported "set N values" on a parquet
### sheet and changed nothing: Column.putValue is a silent no-op when a column
### has no setter (column.py), and ParquetColumn defines none, so every write was
### dropped on the floor while the status line claimed success.
###
### The loader already intends this to work — its rowdef comment describes rows
### as {'__rownum__': int, parquet_col: overridden_value} — but calcValue only
### ever reads from the arrow array and ignores such an override. So: store
### writes under the column name, and prefer that over the arrow value on read.
### Nothing is written back to the .parquet file itself until you save.
from visidata.loaders.parquet import ParquetColumn

_orig_parquet_calcValue = ParquetColumn.calcValue


def _parquet_calcValue(col, row):
    if col.name in row:
        return row[col.name]
    return _orig_parquet_calcValue(col, row)


def _parquet_putValue(col, row, val):
    row[col.name] = val
    # large_string columns are cached (cache=True in the loader), and the cache
    # is consulted before calcValue — so a stale entry would hide the edit.
    if col._cachedValues is not None:
        col._cachedValues.pop(col.sheet.rowid(row), None)


ParquetColumn.calcValue = _parquet_calcValue
ParquetColumn.putValue = _parquet_putValue

### Don't auto-open the guide sidebar (columns sheet C, frequency table F, and
### most other sheets carry a .guide) — it stole half the screen.
###
### disp_sidebar alone was not enough: 'b' (sidebar-toggle) flips that same
### global option, so the first 'b' press turned guides back ON, and every sheet
### pushed afterwards showed one again — which is why it kept coming back on C
### and F. Dropping 'guides' from disp_help_flags is what actually settles it:
### drawSidebar requires wantsHelp('guides'), so no guide draws whatever state
### the toggle is left in. Keep disp_sidebar=False too, since that one also gates
### the disp_sidebar_fmt default sidebar.
###
### Status and error messages keep using the sidebar area regardless — they're
### unconditional in drawSidebar — and any keystroke clears them.
vd.options.disp_sidebar = False
vd.options.disp_help_flags = (
    "cmdpalette help hints inputfield inputkeys nometacols sidebar"
)

### Autotyping by column name. VisiData has NO value-sniffing autotype: text
### loaders (csv/tsv/json/jsonl) hand every column back as anytype, so #/%/@ has
### to be pressed per column. Only self-describing formats (parquet/arrow via
### arrow_to_vdtype, sqlite) carry real types — which also means SQL casts
### (::float, ::timestamp) are invisible to vd when the result is piped through
### JSON/CSV, as the snow/psql runners in nvim keymaps.lua do.
###
### So: type by column NAME instead, applied after every load. That makes the
### query itself the control surface — alias a column to a name matching a rule
### below (e.g. `sum(volume) as volume_num`, `ts::timestamp as booked_ts`) and it
### comes up typed. Exact names win over patterns; a column that already has a
### type (parquet, sqlite) is never overridden.
###
### Built-in alternative for one-offs, exact names only:  Sheet.knownCols.volume.type = float
import re

from visidata import Sheet, anytype, date

### German number notation: 523,992 and 1.234,56. VisiData ships `floatlocale`
### (locale.atof), but that needs a de_DE locale generated system-wide (this box
### has only C and en_US) and then changes float *formatting* process-wide too.
### Parsing both separators directly avoids either problem.
###
### Only safe on genuinely German data: it would read the US thousands "1.234"
### as 1234. Hence applied by column name below, never by sniffing values.
@vd.numericType("%")
def floatde(*args):
    "float() for German notation: '1.234,56' -> 1234.56"
    if not args or args[0] is None or args[0] == "":
        return 0.0
    return float(str(args[0]).strip().replace(".", "").replace(",", "."))


Sheet.addCommand("z^F", "type-floatde", "cursorCol.type = floatde", "set type of current column to German float")
ColumnsSheet.addCommand(
    "gz^F", "type-floatde-selected", "onlySelectedRows.type = floatde", "set type of selected source columns to German float"
)

vd_type_by_name = {
    "volume": float,
    "quantity": float,
    "qty": float,
    "amount": float,
    # Lowercase keys only: the lookup does col.name.lower(), so "Menge" and
    # "Preis" sat here unreachable. And German columns need floatde, not float —
    # float("523,992") raises, which is why % looked broken on them.
    "menge": floatde,
    "wert": floatde,
    "betrag": floatde,
    "summe": floatde,
    "leistung": floatde,
    "price": float,
    "preis": floatde,
    "power": float,
    "timestamp": date,
}
### NB: don't add generic names like 'value' here — VisiData's own metasheets
### (options, memory, pyobj) have a 'value' column full of strings.

vd_type_by_pattern = [
    (re.compile(r"_(start|end|date|ts|time|datetime)$"), date),
    (re.compile(r"_(num|qty|amt|vol|volume|price|amount|value)$"), float),
    (re.compile(r"_(preis|menge|wert|betrag|summe|leistung)$"), floatde),
]


### Rule tables are bound as default args purely to pin them at definition time.
### (Top-level rc names *are* reachable from function bodies at call time: the rc
### is exec'd with locals != globals, but loadConfigFile then feeds those locals
### to vd.addGlobals, which updates the very dict these functions close over.)
@Sheet.after
def afterLoad(
    sheet, _exact=vd_type_by_name, _patterns=vd_type_by_pattern, _untyped=anytype
):
    for col in sheet.columns:
        if col.type is not _untyped:
            continue
        t = _exact.get(col.name.lower())
        if t is None:
            for pat, pattype in _patterns:
                if pat.search(col.name.lower()):
                    t = pattype
                    break
        if t is not None:
            col.type = t


### Timezone conversion inside expressions (= addcol-expr, z| select-expr).
### Names defined at rc top level end up in the expression globals, so this
### replaces the __import__('zoneinfo') dance:
###
###   naive UTC column  ->  ts.replace(tzinfo=UTC).astimezone(BERLIN)
###   tz-aware column   ->  ts.astimezone(BERLIN)          # parquet timestamp[us, tz=…]
###
### Use this rather than a fixed `ts + hours`: a delivery series stored in UTC is
### +1h from Berlin only in winter and +2h under CEST, so a flat shift leaves
### every summer day starting at 23:00. .astimezone() gets the DST switch right.
### The column must actually be date-typed — on an untyped column the value is
### still a str and .replace() silently takes the str.replace() path.
from zoneinfo import ZoneInfo

UTC = ZoneInfo("UTC")
BERLIN = ZoneInfo("Europe/Berlin")

### Keybindings
Sheet.unbindkey(":")
Sheet.bindkey(":", "split-col")


### Copy the current sheet's file path to the system clipboard. VisiData ships
### syscopy-* for rows/cells/column names but nothing for sheet.source, and the
### only built-in route is S -> move to the `source` column -> zY -> q.
### Alt+ is the prefix VisiData reserves for user bindings (Alt+p is taken by
### menu-plot, and plain ^Y is pyobj-row).
###
### Walks up the source chain rather than using sheet.source directly: on a
### derived sheet the source is another sheet (freq table) or a list of them
### (columns sheet), so the naive version copied "[<JsonSheet: tz>]". This way
### Alt+y from C or F still yields the underlying file.
@BaseSheet.api
def sourcePath(sheet):
    node = sheet
    for _ in range(10):  # cycle guard; nesting is never this deep
        src = getattr(node, "source", None)
        if isinstance(src, visidata.Path):
            return str(src)
        if isinstance(src, list) and src:
            src = src[0]
        if not isinstance(src, BaseSheet):
            return ""
        node = src
    return ""


BaseSheet.addCommand(
    "Alt+y",
    "syscopy-path",
    'syscopyValue(sourcePath() or fail("sheet has no file path"))',
    "copy this sheet's source path to system clipboard",
)

