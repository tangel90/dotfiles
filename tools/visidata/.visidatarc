from visidata import vd, VisiData, Sheet, asyncthread

@VisiData.api
@asyncthread
def plot_seaborn_line(vd, rows, xcols, ycols):
    import multiprocessing
    multiprocessing.Process(target=_vd_lineplot, args=(rows, xcols, ycols)).start()

def _vd_lineplot(rows, xcols, ycols):
    plt = vd.importExternal('matplotlib.pyplot', 'matplotlib')
    sns = vd.importExternal('seaborn')
    sns.set()
    plt.figure(figsize=(12, 6)); plt.xticks(rotation=15)
    catcols = [c for c in xcols if not vd.isNumeric(c)]
    numcols = vd.numericCols(xcols)
    X, Y, C = [], [], []
    for rn, row in enumerate(rows):
        for ycol in ycols:
            try:
                k = tuple(c.getValue(row) for c in catcols)
                k = (k[0] if len(catcols) == 1 else k) if catcols else ycol.name
                X.append(numcols[0].type(numcols[0].getValue(row)) if numcols else rn)
                Y.append(ycol.type(ycol.getValue(row))); C.append(k)
            except Exception:
                pass
    sns.lineplot(x=X, y=Y, hue=C if catcols else None, sort=True, linewidth=1)
    plt.show()

Sheet.addCommand(None, 'plot-column-line', 'plot_seaborn_line(rows, keyCols, numericCols([cursorCol]))',
                 'line plot of current numeric column vs key columns using seaborn')
Sheet.addCommand(None, 'plot-numerics-line', 'plot_seaborn_line(rows, keyCols, numericCols(nonKeyVisibleCols))',
                 'line plot of all visible numeric columns vs key columns using seaborn')

### Make seaborn line plot the default (. / g.), move terminal scatter to z. / gz.
Sheet.unbindkey('.')
Sheet.unbindkey('g.')
Sheet.bindkey('.',   'plot-column-line')
Sheet.bindkey('g.',  'plot-numerics-line')
Sheet.bindkey('z.',  'plot-column')      # original terminal scatter (single column)
Sheet.bindkey('gz.', 'plot-numerics')    # original terminal scatter (all numerics)
